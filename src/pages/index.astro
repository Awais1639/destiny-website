---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import HeroGlobe from '../components/HeroGlobe.astro';
import ScholarshipCard from '../components/ScholarshipCard.astro';
import StatusBadge from '../components/StatusBadge.astro';
import Faq from '../components/Faq.astro';
import { faqPage } from '../lib/seo';
import CtaBand from '../components/CtaBand.astro';
import '../styles/motion.css';
import { site } from '../config/site';
import { scholarships, url } from '../lib/data';
import { getStatus, sortScholarships, formatDate, fundingLabel, isActive } from '../lib/scholarships';
import { countries } from '../data/countries';
import { degreeLabels, subjectLabels, fundingLabels } from '../data/taxonomy';
import { services } from '../data/services';
import { em, emProgrammes, emTopics } from '../lib/erasmus';
import { it as itData, itUnis } from '../lib/italy';
import ItalyMap from '../components/art/ItalyMap.astro';
import { buildIndex, fLevels, fSubjects } from '../lib/finder';
import { phdProgrammes } from '../lib/phd';
import { postdocs } from '../lib/postdoc';
import { fellowships } from '../lib/fellowships';
import { conferences } from '../lib/conferences';
import { tools } from '../data/tools';
import '../styles/tools.css';
const fIndex = buildIndex();
const confUpcoming = [...conferences].filter((c) => ['open', 'closing-soon', 'upcoming'].includes(getStatus(c as any))).sort((a, b) => (a.dates.deadline ?? a.dates.opens ?? '9').localeCompare(b.dates.deadline ?? b.dates.opens ?? '9')).slice(0, 3);
const confCountries = new Set(conferences.flatMap((c) => c.countries)).size;
const finderTotal = fIndex.length;
const fCount = (t: string) => fIndex.filter((i) => i.t === t).length;
const fLevelCount = (l: string) => fIndex.filter((i) => (i.t === 'course' || i.t === 'funding') && (i.l as string[]).includes(l)).length;
const fSubjectCount = (j: string) => fIndex.filter((i) => i.t === 'course' && (i.j as string[]).includes(j)).length;

const byDeadline = sortScholarships(scholarships, 'deadline');
const active = byDeadline.filter((s) => isActive(getStatus(s)));
const varies = scholarships.filter((s) => getStatus(s) === 'varies');
const horizon = [...active, ...varies].slice(0, 4);
const featured = scholarships.filter((s) => s.featured && s.fundingType === 'fully-funded');
const lead = featured.find((s) => isActive(getStatus(s))) ?? featured[0];
const featuredRest = featured.filter((s) => s !== lead).slice(0, 4);
const recent = sortScholarships(scholarships, 'newest').slice(0, 3);
const heroCard = active[0];

// 3D globe tour: capital-city coordinates for each destination, each paired with a real listing
const capitals: Record<string, [number, number]> = {
  'united-kingdom': [51.5, -0.13], france: [48.86, 2.35], germany: [52.52, 13.4], italy: [41.9, 12.5], hungary: [47.5, 19.04],
  sweden: [59.33, 18.07], turkiye: [39.93, 32.86], russia: [55.76, 37.62], china: [39.9, 116.4], japan: [35.68, 139.65],
  'south-korea': [37.57, 126.98], 'united-states': [38.9, -77.04], europe: [50.85, 4.35],
};
const tourOrder = ['united-kingdom', 'turkiye', 'japan', 'germany', 'south-korea', 'hungary', 'united-states', 'china', 'france', 'sweden', 'italy', 'russia'];
const statusRank = (x: (typeof scholarships)[number]) => (isActive(getStatus(x)) ? 0 : getStatus(x) === 'varies' ? 1 : 2);
const globeDests = tourOrder.map((slug) => {
  const c = countries.find((x) => x.slug === slug)!;
  const sch = scholarships.filter((x) => x.countries.includes(slug)).sort((a, b) => statusRank(a) - statusRank(b) || Number(b.featured) - Number(a.featured))[0];
  return {
    code: c.code, name: c.name, local: c.localName, lat: capitals[slug][0], lon: capitals[slug][1],
    sch: sch ? { title: sch.title, href: url(`/scholarships/${sch.slug}/`), funding: fundingLabel(sch.fundingType), status: getStatus(sch) } : null,
    countryHref: url(`/countries/${slug}/`),
  };
});
const globeOrigin = { code: 'PK', name: 'Pakistan', local: 'پاکستان', lat: 33.69, lon: 73.05 };
const statusText: Record<string, string> = { open: 'Open', 'closing-soon': 'Closing soon', upcoming: 'Opening soon', closed: 'Closed for this cycle', varies: 'Deadlines vary', unconfirmed: 'Cycle not yet confirmed' };
const first = globeDests[0];

const destCount = countries.length;
const verifiedOfficial = scholarships.filter((s) => s.verification.level === 'official').length;
const lastChecked = scholarships.map((s) => s.verification.lastChecked).sort().at(-1);
const countFor = (slug: string) => scholarships.filter((s) => s.countries.includes(slug)).length;
const degreeCount = (d: string) => scholarships.filter((s) => s.degreeLevels.includes(d)).length;
const subjectKeys = Object.keys(subjectLabels).filter((k) => k !== 'any');

const faqs = [
  { q: 'Is this website free to use?', a: 'Yes. Searching, reading listings, saving scholarships and reading guides are free and need no account. Consultancy assistance is a separate service — ask us about it through the inquiry form.' },
  { q: 'Do I have to apply through Destiny Global Solutions?', a: 'No. Every listing has an <strong>official website</strong> button that takes you to the scholarship provider. You can apply entirely on your own. Our assistance is optional.' },
  { q: 'Can you guarantee a scholarship, admission or visa?', a: 'No — and you should be cautious of anyone who does. Providers, universities and governments make all selection and visa decisions.' },
  { q: 'How current is the information?', a: 'Each listing shows when it was last checked and whether it was verified on an official source. Cycles and deadlines change every year, so always confirm on the official website before applying. <a href="' + url('/scholarship-verification/') + '">How we verify</a>.' },
  { q: 'Why does a listing say “Cycle not yet confirmed”?', a: 'It means the provider has not published dates for the next round yet (or we have not verified them). We never assume a scholarship is open based on last year’s dates.' },
  { q: 'Where are my saved scholarships stored?', a: 'Only in your own browser on this device (local storage). Nothing is sent to us. Clearing your browser data removes the list.' },
];
const emTicker = emProgrammes.filter((p) => p.acronym.length <= 14).map((p) => p.acronym);
const emTickA = emTicker.filter((_, i) => i % 2 === 0), emTickB = emTicker.filter((_, i) => i % 2 === 1);
---
<BaseLayout
  title="Destiny Global — Scholarships, Courses & Study Abroad Guidance"
  description="Discover fully funded scholarships, read verified eligibility details, apply directly on official websites or get optional application assistance from Destiny Global Solutions Limited."
  darkHero
  jsonLd={faqPage(faqs)}
>
  <!-- ================= HERO ================= -->
  <section class="hero on-dark">
    <div class="scroll-progress" data-progress aria-hidden="true"></div>
    <div class="hero__bg" aria-hidden="true"></div>
    <canvas class="stars" data-stars aria-hidden="true"></canvas>
    <div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="spotlight" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow hero-in">Courses · Scholarships · Admissions</p>
        <h1 class="display-xl" data-split data-split-done="1" aria-label="Discover opportunities. Unlock your future."><span class="w" aria-hidden="true"><span style="--wi:0">Discover</span></span> <span class="w" aria-hidden="true"><span style="--wi:1">opportunities.</span></span><br /><span class="serif-i gold underline-sweep shimmer"><span class="w" aria-hidden="true"><span style="--wi:2">Unlock</span></span> <span class="w" aria-hidden="true"><span style="--wi:3">your</span></span> <span class="w" aria-hidden="true"><span style="--wi:4">future.</span></span></span></h1>
        <p class="hero-dest hero-in" data-d="2" aria-live="polite">
          <span class="hero-dest__plane" aria-hidden="true"><Icon name="plane" size={16} /></span>
          Your next chapter could begin in
          <a class="hero-dest__word" data-dest-word href={first.countryHref}>{first.name}</a>
        </p>
        <p class="lead hero-in" data-d="2">Search {finderTotal.toLocaleString('en-GB')} courses, scholarships, grants and universities in one place — every course shows the funding you can apply for, checked against official sources.</p>

        <form class="hero-search hero-search--finder hero-in" data-d="3" action={url('/find/')} method="get" role="search" aria-label="Search courses, scholarships and universities">
          <fieldset class="hero-tabs">
            <legend class="sr-only">What are you looking for?</legend>
            <label><input type="radio" name="type" value="" checked /><span>Everything</span></label>
            <label><input type="radio" name="type" value="course" /><span>Courses</span></label>
            <label><input type="radio" name="type" value="funding" /><span>Scholarships</span></label>
            <label><input type="radio" name="type" value="university" /><span>Universities</span></label>
          </fieldset>
          <div class="hero-search__row">
            <div class="hero-search__q">
              <Icon name="search" />
              <label class="sr-only" for="hero-q">What do you want to study?</label>
              <input id="hero-q" name="q" type="search" placeholder="What do you want to study?" autocomplete="off" data-typewriter="Data science in Italy|Medicine in English|Fully funded master’s|Erasmus Mundus AI|PhD scholarships|Architecture Milan" />
            </div>
            <button class="btn btn-gold hero-search__go" type="submit">Search</button>
          </div>
        </form>

        <div class="hero-quick hero-in" data-d="4" aria-label="Popular searches">
          <span class="tiny">Popular:</span>
          <a href={url('/find/?q=computer+science&type=course')}>Computer science</a>
          <a href={url('/find/?q=medicine&type=course')}>Medicine</a>
          <a href={url('/find/?q=business&type=course&level=master')}>Business master’s</a>
          <a href={url('/find/?type=funding&funding=fully-funded')}>Fully funded</a>
          <a href={url('/find/?open=1')}>Open now</a>
          <a href={url('/scholarships/italy-regional-grants/')}>Italy grants</a>
        </div>

        <div class="hero__ctas hero-in" data-d="5">
          <a class="btn btn-primary btn-lg btn-shine" data-magnetic href={url('/find/')}>Open course finder <Icon name="arrow-right" /></a>
          <a class="btn btn-ghost-light btn-lg" data-magnetic href={url('/contact/')}>Get Consultancy Assistance</a>
        </div>
      </div>

      <div class="hero__visual">
        <div class="globe3d" data-globe3d data-depth="14" data-origin={JSON.stringify(globeOrigin)} data-dests={JSON.stringify(globeDests)}
             role="img" aria-label="Interactive globe showing flight paths from Pakistan to study destinations. Drag to spin.">
          <div class="orbit orbit--1" aria-hidden="true"><i></i></div>
          <div class="orbit orbit--2" aria-hidden="true"><i></i></div>
          <div class="globe3d__fallback"><HeroGlobe /></div>
          <span class="drag-hint" aria-hidden="true"><Icon name="globe" size={14} /> Drag to spin</span>
        </div>

        <a class="float-card float-card--now" data-depth="40" data-now href={first.sch?.href ?? first.countryHref}>
          <span class="tiny fc-label"><span class="live-dot"></span> Now exploring</span>
          <span class="now__place"><span class="now__local" data-now-local>{first.local}</span><span class="now__name" data-now-name>{first.local === first.name ? '' : first.name}</span></span>
          <span class="now__sch" data-now-sch>{first.sch?.title}</span>
          <span class="fc-meta"><span data-now-meta>{first.sch ? `${first.sch.funding} · ${statusText[first.sch.status]}` : ''}</span><Icon name="arrow-right" size={14} /></span>
        </a>

        {heroCard && (
          <a class="float-card float-card--a" data-depth="-34" href={url(`/scholarships/${heroCard.slug}/`)}>
            <div class="flex justify-between items-center gap-2"><span class="tiny fc-label">Deadline approaching</span><StatusBadge s={heroCard} /></div>
            <strong>{heroCard.title}</strong>
            <span class="fc-meta"><Icon name="calendar" size={14} /> {formatDate(heroCard.dates.deadline)} · {fundingLabel(heroCard.fundingType)}</span>
          </a>
        )}
      </div>
    </div>

    <div class="container">
      <dl class="hero-stats hero-in" data-d="6">
        <div><dt>Courses</dt><dd data-countup={fCount('course')}>{fCount('course')}</dd></div>
        <div><dt>Scholarships & grants</dt><dd data-countup={fCount('funding')}>{fCount('funding')}</dd></div>
        <div><dt>Universities</dt><dd data-countup={fCount('university')}>{fCount('university')}</dd></div>
        <div><dt>Listings last checked</dt><dd class="small-dd">{formatDate(lastChecked)}</dd></div>
      </dl>
    </div>
  </section>

  <!-- ================= START HERE: SECTIONS ================= -->
  <section class="section-tight start">
    <div class="container">
      <p class="eyebrow reveal">Start here</p>
      <h2 class="display-m mt-3 reveal">Everything in four places</h2>
      <ul class="start-grid mt-5 stagger">
        <li><a class="start-card start-card--course" href={url('/find/?type=course')}>
          <span class="start-card__ico"><Icon name="graduation" /></span>
          <strong>Find a course</strong>
          <span>{fCount('course').toLocaleString('en-GB')} English-taught degrees in Italy and Erasmus Mundus master’s across Europe — each with its funding options.</span>
          <em>Search courses <Icon name="arrow-right" /></em>
        </a></li>
        <li><a class="start-card start-card--fund" href={url('/scholarships/')}>
          <span class="start-card__ico"><Icon name="award" /></span>
          <strong>Fund your studies</strong>
          <span>Government scholarships in {destCount} destinations, Erasmus Mundus scholarships and Italy’s regional grants in all 20 regions.</span>
          <em>Scholarships & grants <Icon name="arrow-right" /></em>
        </a></li>
        <li><a class="start-card start-card--uni" href={url('/universities/')}>
          <span class="start-card__ico"><Icon name="building" /></span>
          <strong>Universities & countries</strong>
          <span>{fCount('university')} Italian universities and {destCount} study destinations with official resources and guidance.</span>
          <em>Explore destinations <Icon name="arrow-right" /></em>
        </a></li>
        <li><a class="start-card start-card--help" href={url('/services/')}>
          <span class="start-card__ico"><Icon name="users" /></span>
          <strong>Get help</strong>
          <span>Admissions, scholarship applications, visas and IELTS / PTE / SAT coaching — optional and separate from official applications.</span>
          <em>Services & coaching <Icon name="arrow-right" /></em>
        </a></li>
      </ul>
    </div>
  </section>

  <!-- ================= RESEARCH & EVENTS ================= -->
  <section class="section bg-paper-2" id="research-events">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Beyond scholarships</p>
          <h2 class="display-l" data-split>PhD, fellowships, conferences & summits</h2>
        </div>
        <a class="link-arrow" href={url('/conferences/')}>All conferences & summits <Icon name="arrow-right" /></a>
      </div>
      <ul class="re-grid stagger">
        <li><a class="re-tile" href={url('/phd/')}><Icon name="graduation" /><strong>PhD positions</strong><span>{phdProgrammes.length} funded doctoral programmes and networks</span></a></li>
        <li><a class="re-tile" href={url('/postdoc/')}><Icon name="award" /><strong>Postdoc positions</strong><span>{postdocs.length} fellowships and programmes after the PhD</span></a></li>
        <li><a class="re-tile" href={url('/fellowships/')}><Icon name="users" /><strong>Fellowships</strong><span>{fellowships.length} leadership, research and visiting fellowships</span></a></li>
        <li><a class="re-tile re-tile--hot" href={url('/conferences/')}><Icon name="calendar" /><strong>Conferences & summits</strong><span>{conferences.length} events with funded places or travel grants in {confCountries} countries</span></a></li>
      </ul>
      {confUpcoming.length > 0 && <>
        <h3 class="re-sub mt-6">Funded conference places — apply soon</h3>
        <ul class="re-list">
          {confUpcoming.map((c) => (
            <li><a class="re-row" href={url(`/conferences/${c.slug}/`)}>
              <span class="re-row__t"><strong>{c.title}</strong><small>{c.location} · {c.duration}</small></span>
              <span class="re-row__d">{c.dates.deadline ? <>Apply by <b>{formatDate(c.dates.deadline)}</b></> : c.dates.opens ? <>Opens <b>{formatDate(c.dates.opens)}</b></> : null}</span>
              <StatusBadge s={c as any} />
            </a></li>
          ))}
        </ul>
      </>}
    </div>
  </section>

  <!-- ================= FREE TOOLS ================= -->
  <section class="section" id="tools">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Free tools</p>
          <h2 class="display-l" data-split>Plan smarter, in minutes</h2>
        </div>
        <a class="link-arrow" href={url('/tools/')}>All tools <Icon name="arrow-right" /></a>
      </div>
      <ul class="tools-grid stagger">
        {tools.slice(0, 6).map((t) => (
          <li><a class="tool-card" href={t.external ? t.href : url(t.href)} {...(t.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
            <Icon name={t.icon} /><strong>{t.label}</strong><span>{t.text}</span><em>{t.cta} →</em>
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================= DEADLINES ================= -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">On the horizon</p>
          <h2 class="display-l" data-split>Deadlines coming up</h2>
          <p class="lead">Rounds that are open now, soonest deadline first — plus programmes where each university sets its own date.</p>
        </div>
        <a class="link-arrow" href={url('/scholarships/?sort=deadline')}>All deadlines <Icon name="arrow-right" /></a>
      </div>
      <ol class="timeline stagger">
        {horizon.map((s) => {
          const st = getStatus(s);
          return (
            <li class="timeline__item">
              <div class="timeline__date">
                {s.dates.deadline ? (
                  <>
                    <span class="d">{formatDate(s.dates.deadline).split(' ')[0]}</span>
                    <span class="m">{formatDate(s.dates.deadline).split(' ').slice(1).join(' ')}</span>
                  </>
                ) : (
                  <span class="m">Varies</span>
                )}
              </div>
              <div class="timeline__body">
                <div class="flex wrap gap-2 items-center"><StatusBadge s={s} /><span class="tiny muted">{s.countries.map((c) => countries.find((x) => x.slug === c)?.name).join(', ')}</span></div>
                <h3><a href={url(`/scholarships/${s.slug}/`)}>{s.title}</a></h3>
                <p class="small muted mb-0">{s.dates.deadlineNote}</p>
              </div>
              <a class="btn btn-outline btn-sm timeline__go" href={url(`/scholarships/${s.slug}/`)} aria-label={`View ${s.title}`}>View <Icon name="arrow-right" /></a>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <!-- ================= FEATURED ================= -->
  <section class="section bg-surface">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Featured</p>
          <h2 class="display-l" data-split>Fully funded programmes worth knowing</h2>
          <p class="lead">Labelled “fully funded” only where official information describes tuition and living costs as covered.</p>
        </div>
        <a class="link-arrow" href={url('/scholarships/?funding=fully-funded')}>All fully funded <Icon name="arrow-right" /></a>
      </div>
      <div class="featured">
        {lead && (
          <a class="featured__lead reveal" data-tilt href={url(`/scholarships/${lead.slug}/`)}>
            <div class="flex wrap gap-2 items-center"><StatusBadge s={lead} /><span class="badge badge-fund">{fundingLabel(lead.fundingType)}</span></div>
            <h3>{lead.title}</h3>
            <p>{lead.summary}</p>
            <dl class="featured__facts">
              <div><dt>Stipend</dt><dd>{lead.coverage.stipend ?? 'See official source'}</dd></div>
              <div><dt>Deadline</dt><dd>{formatDate(lead.dates.deadline)}</dd></div>
            </dl>
            <span class="link-arrow" style="color:var(--coral)">Read eligibility & apply <Icon name="arrow-right" /></span>
          </a>
        )}
        <div class="featured__grid stagger">
          {featuredRest.map((s, i) => <div><ScholarshipCard s={s} /></div>)}
        </div>
      </div>
    </div>
  </section>

  <!-- ================= ERASMUS MUNDUS FINDER ================= -->
  <section class="section emband on-dark">
    <div class="emband__tick" aria-hidden="true">
      <div class="emband__row"><span>{emTickA.join(' · ')} · </span><span>{emTickA.join(' · ')} · </span></div>
      <div class="emband__row emband__row--b"><span>{emTickB.join(' · ')} · </span><span>{emTickB.join(' · ')} · </span></div>
    </div>
    <div class="container emband__in reveal">
      <p class="eyebrow" style="color:var(--coral)">New · Erasmus Mundus Programme Finder</p>
      <h2 class="display-l" style="color:#fff" data-split>{em.count} joint master’s programmes. One search.</h2>
      <p class="lead emband__lead">Every programme in the official EU Erasmus Mundus Catalogue — study in two or more European countries. Find yours, then apply on its official website or with our help.</p>
      <form class="emband__search" action={url('/scholarships/erasmus-mundus/')} method="get" role="search">
        <label for="emb-q" class="sr-only">Search Erasmus Mundus programmes</label>
        <Icon name="search" />
        <input id="emb-q" name="q" type="search" placeholder="Subject or programme, e.g. “water”, “AI”, “NOHA”" autocomplete="off" />
        <button class="btn btn-primary" type="submit">Search</button>
      </form>
      <div class="emband__topics">
        {Object.entries(emTopics).filter(([k]) => k !== 'other').slice(0, 6).map(([k, label]) => (
          <a href={url(`/scholarships/erasmus-mundus/?topic=${k}`)}>{label}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= UNIVERSITIES: ITALY ================= -->
  {itData.count > 0 && <section class="section">
    <div class="container">
      <div class="itband reveal">
        <div class="itband__text">
          <p class="eyebrow" style="color:var(--coral)">New · University finder</p>
          <h2 class="display-l" style="color:#fff">Every English-taught degree in Italy</h2>
          <p class="itband__lead">{itData.count} bachelor’s and master’s programmes at {itUnis.length} Italian universities, from the Ministry of University and Research’s official data. Open any programme to reach the university — or apply with our help.</p>
          <form class="emband__search itband__search" action={url('/universities/italy/')} method="get" role="search">
            <label for="itb-q" class="sr-only">Search English-taught programmes in Italy</label>
            <Icon name="search" />
            <input id="itb-q" name="q" type="search" placeholder="e.g. “computer engineering”, “Milano”" autocomplete="off" />
            <button class="btn btn-primary" type="submit">Search</button>
          </form>
          <p class="itband__links"><a href={url('/universities/italy/?level=bachelor')}>Bachelor’s</a><a href={url('/universities/italy/?level=master')}>Master’s</a><a href={url('/universities/italy/?view=universities')}>All universities</a></p>
        </div>
        <div class="itband__art"><ItalyMap /></div>
      </div>
    </div>
  </section>}

  <!-- ================= TWO ROUTES ================= -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal" style="justify-content:center;text-align:center">
        <div style="margin-inline:auto">
          <p class="eyebrow">Your choice, always</p>
          <h2 class="display-l" data-split>Two ways to apply — clearly separated</h2>
          <p class="lead">Every scholarship page offers both. We never send the official-application button to our own form.</p>
        </div>
      </div>
      <div class="routes">
        <article class="route route--direct reveal" data-anim="left">
          <span class="route__tag">Route 1</span>
          <div class="route__icon"><Icon name="external" /></div>
          <h3>Apply directly</h3>
