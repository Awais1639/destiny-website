---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PageHero from '../../../../components/PageHero.astro';
import Icon from '../../../../components/Icon.astro';
import CtaBand from '../../../../components/CtaBand.astro';
import ItalyUpdateBox from '../../../../components/ItalyUpdateBox.astro';
import RegionalGrantCard from '../../../../components/RegionalGrantCard.astro';
import { url } from '../../../../lib/data';
import { formatDate } from '../../../../lib/scholarships';
import { it, itUnis, itProgs, uniUpdates, progUpdates, progKey, progUrl, typeLabels, levelShort, languageLabel, isEnglishOnly, type ItUni, type Level } from '../../../../lib/italy';

export function getStaticPaths() {
  return itUnis.map((u) => ({ params: { uni: u.slug }, props: { u } }));
}
const { u } = Astro.props as { u: ItUni };
const uu = uniUpdates[u.slug];
const progs = itProgs.filter((p) => p.uni === u.code);
const order: Level[] = ['bachelor', 'master', 'single-cycle', 'other'];
const groups = order.map((l) => ({ l, items: progs.filter((p) => p.level === l) })).filter((g) => g.items.length);
const host = (h?: string | null) => { try { return h ? new URL(h).hostname.replace(/^www\./, '') : ''; } catch { return ''; } };
---
<BaseLayout title={`${u.name} — English-taught programmes`} description={`${progs.length} English-taught degree programme${progs.length === 1 ? '' : 's'} at ${u.name}${u.city ? ` (${u.city})` : ''}, from official Ministry data — with official links and application assistance.`}>
  <PageHero
    variant="dark"
    eyebrow={`${typeLabels[u.type]}${u.city ? ` · ${u.city}` : ''}${u.region ? `, ${u.region}` : ''}`}
    title={u.name}
    lead={`${progs.length} English-taught degree programme${progs.length === 1 ? '' : 's'} listed by the Ministry of University and Research for ${it.academicYear}.`}
    crumbs={[{ label: 'Universities', href: '/universities/' }, { label: 'Italy', href: '/universities/italy/' }, { label: u.short }]}
  >
    <div class="iu-actions">
      {uu?.admissionsUrl && <a class="btn btn-primary" href={uu.admissionsUrl} target="_blank" rel="noopener noreferrer">International admissions <Icon name="external" /></a>}
      {u.website && <a class:list={['btn', uu?.admissionsUrl ? 'btn-ghost-light' : 'btn-primary']} href={u.website} target="_blank" rel="noopener noreferrer">Official website · {host(u.website)} <Icon name="external" /></a>}
      <a class="btn btn-ghost-light" href={url('/contact/')}>Get application assistance</a>
    </div>
    <ul class="iu-stats">
      {groups.map((g) => <li><b>{g.items.length}</b> {levelShort[g.l].toLowerCase()}</li>)}
    </ul>
  </PageHero>

  <section class="section-tight">
    <div class="container iu">
      <div>
        {groups.map((g) => (
          <div class="iu-group">
            <h2 class="display-m">{it.levels[g.l]} <span>{g.items.length}</span></h2>
            <ul class="iu-list">
              {g.items.map((p) => (
                <li><a href={url(progUrl(p))}>
                  <span class="iu-list__name">{p.name}</span>
                  <span class="iu-list__meta">{p.city}{!isEnglishOnly(p) && ` · ${languageLabel(p.language)}`}{progUpdates[progKey(p)] && <span class="iu-ok"><Icon name="check" size={12} /> Checked</span>}</span>
                  <Icon name="arrow-right" />
                </a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <aside>
        <h2 class="side-h">Admission rules for international applicants</h2>
        <ItalyUpdateBox uni={uu} uniName={u.short} fallbackUrl={u.website} />
        <RegionalGrantCard uniSlug={u.slug} class="mt-4" />
        <div class="card mt-4" style="padding:20px">
          <h2 class="side-h">University details</h2>
          <dl class="iu-dl">
            <div><dt>Official name</dt><dd>{u.name}</dd></div>
            <div><dt>Type</dt><dd>{typeLabels[u.type]}</dd></div>
            {u.city && <div><dt>City</dt><dd>{u.city}</dd></div>}
            {u.region && <div><dt>Region</dt><dd>{u.region}</dd></div>}
            <div><dt>Programme list</dt><dd>Ministry data {it.academicYear}</dd></div>
            {u.checkedOn && <div><dt>Details checked</dt><dd>{formatDate(u.checkedOn)}</dd></div>}
          </dl>
        </div>
      </aside>
    </div>
  </section>

  <section class="section-tight" style="padding-top:0">
    <div class="container"><div class="notice"><Icon name="shield" /><p class="small">Programme list from the open data of Italy’s Ministry of University and Research, imported {formatDate(it.imported)}. Destiny Global Solutions Limited is independent and not affiliated with {u.short}.</p></div></div>
  </section>
  <CtaBand />
</BaseLayout>
<style>
  .iu-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
  :global(.btn-ghost-light) { background: rgba(255,255,255,.08); color: #fff; border: 1px solid rgba(255,255,255,.3); }
  :global(.btn-ghost-light:hover) { background: rgba(255,255,255,.16); color: #fff; }
  .iu-stats { list-style: none; padding: 0; margin: 20px 0 0; display: flex; flex-wrap: wrap; gap: 8px 22px; color: rgba(239,232,248,.8); font-size: 14px; }
  .iu-stats b { color: #fff; font-size: 18px; }
  .iu { display: grid; gap: 32px; }
  @media (min-width: 1024px) { .iu { grid-template-columns: minmax(0, 1fr) 360px; gap: 48px; align-items: start; } .iu > aside { position: sticky; top: calc(var(--header-h) + 20px); } }
  .iu-group + .iu-group { margin-top: 36px; }
  .iu-group h2 { font-size: 1.5rem; display: flex; align-items: center; gap: 10px; }
  .iu-group h2 span { font-family: var(--font-body, inherit); font-size: 13px; font-weight: 700; padding: 2px 10px; border-radius: 999px; background: var(--plum-50); color: var(--plum-700); }
  .iu-list { list-style: none; padding: 0; margin: 12px 0 0; border-top: 1px solid var(--line); }
  .iu-list a { display: grid; grid-template-columns: 1fr 20px; gap: 2px 12px; padding: 14px 8px; border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; border-radius: 8px; }
  .iu-list a:hover { background: var(--plum-50); }
  .iu-list__name { font-weight: 700; color: var(--ink); overflow-wrap: anywhere; }
  .iu-list__meta { grid-column: 1; font-size: 13px; color: var(--muted); display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .iu-list a > :global(svg) { grid-row: 1 / span 2; grid-column: 2; align-self: center; width: 18px; height: 18px; color: var(--plum-600); }
  .iu-ok { display: inline-flex; align-items: center; gap: 3px; font-size: 11.5px; font-weight: 700; color: var(--ok); background: var(--ok-bg); padding: 1px 7px; border-radius: 6px; }
  .side-h { font-size: 13px; font-weight: 750; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); margin: 0 0 12px; }
  .iu-dl { display: grid; gap: 10px; margin: 0; }
  .iu-dl div { display: flex; justify-content: space-between; gap: 12px; font-size: 14px; }
  .iu-dl dt { color: var(--muted); }
  .iu-dl dd { margin: 0; font-weight: 650; text-align: right; }
</style>
