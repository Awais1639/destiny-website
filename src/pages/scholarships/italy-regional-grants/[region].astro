---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import SchemeNav from '../../../components/SchemeNav.astro';
import Icon from '../../../components/Icon.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { url } from '../../../lib/data';
import { formatDate } from '../../../lib/scholarships';
import { dsu, regions, regionUrl, euro, agencyId, HUB, type Region } from '../../../lib/italy-regional';
import { itUnis, uniUrl } from '../../../lib/italy';

export function getStaticPaths() {
  return regions.map((r) => ({ params: { region: r.slug }, props: { r } }));
}
const { r } = Astro.props as { r: Region };
const n = dsu.national;
const uniBySlug = Object.fromEntries(itUnis.map((u) => [u.slug, u]));
const others = regions.filter((x) => x !== r);
const verified = r.agencies.filter((a) => a.checked).length;
const host = (h: string) => { try { return new URL(h).hostname.replace(/^www\./, ''); } catch { return h; } };
---
<BaseLayout
  title={`Regional scholarships in ${r.name}, Italy (${dsu.academicYear}) — ${r.agencies.map((a) => a.short).join(', ')}`}
  description={`Right-to-study (DSU) grants for university students in ${r.name}: who runs them (${r.agencies.map((a) => a.short).join(', ')}), ${dsu.academicYear} deadlines, income limits and documents for international students — from official sources.`}
>
  <PageHero
    variant="editorial"
    eyebrow={`Italy regional grants · ${r.it}`}
    title={`Regional scholarships in ${r.name}`}
    lead={r.intro ?? `Right-to-study grants for students at universities in ${r.name} are run by ${r.agencies.length === 1 ? r.agencies[0].short : r.agencies.map((a) => a.short).join(', ')}.`}
    crumbs={[{ label: 'Scholarships', href: '/scholarships/' }, { label: 'Italy regional grants', href: HUB }, { label: r.name }]}
  >
    {r.agencies.length > 1 && (
      <nav class="rr-jump" aria-label="Agencies on this page">
        {r.agencies.map((a) => <a href={`#${agencyId(a)}`}>{a.short}</a>)}
      </nav>
    )}
    <SchemeNav current={HUB} />
  </PageHero>

  <section class="section-tight">
    <div class="container rr">
      <div class="rr-main">
        {r.agencies.map((a) => (
          <article class="rr-ag" id={agencyId(a)}>
            <header class="rr-ag__head">
              <div>
                <h2 class="display-m">{a.short}</h2>
                <p class="muted small">{a.name}</p>
              </div>
              <a class="btn btn-primary btn-sm" href={a.url} target="_blank" rel="noopener noreferrer">{host(a.url)} <Icon name="external" /></a>
            </header>
            <p class="rr-covers"><Icon name="graduation" /> <span><strong>Covers:</strong> {a.covers}</span></p>
            {a.unis.some((s) => uniBySlug[s]) && (
              <p class="rr-unis">
                <span class="tiny muted">English-taught degrees on our site:</span>
                {a.unis.filter((s) => uniBySlug[s]).map((s) => <a href={url(uniUrl(uniBySlug[s]))}>{uniBySlug[s].short}</a>)}
              </p>
            )}

            {a.note && <div class="notice notice-warn mt-4"><Icon name="info" /><p class="small">{a.note}</p></div>}

            {a.deadlines.length > 0 && (
              <div class="rr-block">
                <h3>{dsu.academicYear} deadlines</h3>
                <ul class="rr-dl">
                  {a.deadlines.map((d) => (
                    <li>
                      <span class="rr-dl__date"><b>{formatDate(d.date)}</b>{d.time && <span>{d.time} (Italian time)</span>}</span>
                      <span class="rr-dl__what">{d.label}{d.note && <span class="tiny muted">{d.note}</span>}</span>
                      <span class="badge badge-dot badge-closed" data-dl={d.date}>{d.apply ? "Closed" : "Passed"}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {(a.limits || a.amounts) && (
              <div class="rr-block">
                <h3>Income limits and amounts</h3>
                <dl class="rr-nums">
                  {a.limits?.isee != null && <div><dt>Max ISEE</dt><dd>{euro(a.limits.isee)}</dd></div>}
                  {a.limits?.ispe != null && <div><dt>Max ISPE</dt><dd>{euro(a.limits.ispe)}</dd></div>}
                  {a.amounts?.offsite != null && <div><dt>Off-site (max)</dt><dd>{euro(a.amounts.offsite)}</dd></div>}
                  {a.amounts?.commuter != null && <div><dt>Commuter (max)</dt><dd>{euro(a.amounts.commuter)}</dd></div>}
                  {a.amounts?.local != null && <div><dt>In city (max)</dt><dd>{euro(a.amounts.local)}</dd></div>}
                </dl>
                {a.amounts?.note && <p class="tiny muted mt-2">{a.amounts.note}</p>}
              </div>
            )}

            {a.international.length > 0 && (
              <div class="rr-block rr-intl">
                <h3><Icon name="globe" /> International students</h3>
                <ul>{a.international.map((t) => <li>{t}</li>)}</ul>
              </div>
            )}

            {a.links.length > 0 && (
              <div class="rr-links">
                {a.links.map((l) => <a href={l.url} target="_blank" rel="noopener noreferrer"><Icon name="file" /> {l.label} <Icon name="external" /></a>)}
              </div>
            )}

            <p class="rr-src tiny muted">
              {a.checked ? <>Checked {formatDate(a.checked)} on: </> : <>Not yet verified. </>}
              {a.sources.map((s, i) => <>{i > 0 && ' · '}<a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a></>)}
            </p>
          </article>
        ))}
      </div>

      <aside class="rr-side">
        <div class="rr-help">
          <p class="eyebrow">Apply with us</p>
          <h2>Get help with your {r.name} grant application</h2>
          <p class="small">We can help you gather and organise your family income documents, follow the agency’s steps and meet its deadlines. Optional and separate from the agency — no grant is guaranteed.</p>
          <a class="btn btn-primary" href={url('/services/scholarship-application-assistance/')}>Get application assistance <Icon name="arrow-right" /></a>
        </div>
        <div class="card rr-nat">
          <h2 class="side-h">National rules {dsu.academicYear}</h2>
          <dl>
            <div><dt>Minimum grant, off-site</dt><dd>{euro(n.amounts.offsite)}</dd></div>
            <div><dt>Minimum grant, commuter</dt><dd>{euro(n.amounts.commuter)}</dd></div>
            <div><dt>Minimum grant, in city</dt><dd>{euro(n.amounts.local)}</dd></div>
            <div><dt>ISEE ceiling</dt><dd>{euro(n.isee)}</dd></div>
            <div><dt>ISPE ceiling</dt><dd>{euro(n.ispe)}</dd></div>
          </dl>
          <p class="tiny muted">Set by the Ministry of University and Research; regions may use lower income limits. <a href={url(HUB)}>How the grants work</a></p>
        </div>
        <p class="tiny muted">{verified} of {r.agencies.length} {r.agencies.length === 1 ? 'call' : 'calls'} in {r.name} checked on official websites. Always confirm details in the agency’s current call.</p>
      </aside>
    </div>
  </section>

  <section class="section-tight rr-more">
    <div class="container">
      <h2 class="side-h">Other regions</h2>
      <ul class="rr-others">
        {others.map((o) => <li><a href={url(regionUrl(o))}>{o.name}</a></li>)}
      </ul>
    </div>
  </section>
  <CtaBand />
</BaseLayout>

<script>
  // Per-deadline badge, computed in the visitor's browser so it stays current between rebuilds (UTC calendar days).
  const today = Math.floor(Date.now() / 86400000);
  document.querySelectorAll<HTMLElement>('[data-dl]').forEach((el) => {
    const [y, m, d] = (el.dataset.dl || '').split('-').map(Number);
    const left = Math.floor(Date.UTC(y, m - 1, d) / 86400000) - today;
    if (left < 0) return;
    el.className = `badge badge-dot ${left <= 14 ? 'badge-closing-soon' : 'badge-open'}`;
    el.textContent = left === 0 ? 'Today' : `${left} day${left === 1 ? '' : 's'} left`;
  });
</script>

<style>
  .rr-jump { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .rr-jump a { padding: 7px 14px; border-radius: 999px; border: 1px solid var(--line); background: #fff; font-size: 14px; font-weight: 650; color: var(--ink); text-decoration: none; }
  .rr-jump a:hover { border-color: var(--plum-600); color: var(--plum-700); }
  .rr-jump + :global(*) { margin-top: 22px; }

  .rr { display: grid; gap: 36px; }
  @media (min-width: 1024px) { .rr { grid-template-columns: minmax(0, 1fr) 340px; gap: 48px; align-items: start; } .rr-side { position: sticky; top: calc(var(--header-h) + 20px); } }
  .rr-main { display: grid; gap: 28px; }
  .rr-ag { border: 1px solid var(--line); border-radius: 20px; padding: clamp(18px, 3vw, 30px); background: #fff; scroll-margin-top: calc(var(--header-h) + 16px); }
  .rr-ag__head { display: flex; justify-content: space-between; align-items: start; gap: 16px; flex-wrap: wrap; }
  .rr-ag__head h2 { font-size: 1.7rem; margin: 0; }
  .rr-ag__head p { margin: 2px 0 0; }
  .rr-covers { display: grid; grid-template-columns: 20px 1fr; gap: 10px; margin: 16px 0 0; }
  .rr-covers :global(svg) { width: 18px; height: 18px; color: var(--plum-600); margin-top: 3px; }
  .rr-unis { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; margin: 10px 0 0 30px; }
  .rr-unis a { font-size: 13px; font-weight: 650; padding: 3px 10px; border-radius: 999px; background: var(--plum-50); color: var(--plum-700); text-decoration: none; }
  .rr-unis a:hover { background: var(--plum-100, #eadcf9); }
  .rr-block { margin-top: 24px; }
  .rr-block h3 { font-size: 13px; font-weight: 750; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); margin: 0 0 10px; display: flex; align-items: center; gap: 8px; }
  .rr-block h3 :global(svg) { width: 16px; height: 16px; }
  .rr-dl { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .rr-dl li { display: grid; grid-template-columns: 1fr auto; gap: 4px 16px; padding: 12px 2px; border-bottom: 1px solid var(--line); align-items: center; }
  @media (min-width: 640px) { .rr-dl li { grid-template-columns: 170px 1fr auto; } }
  .rr-dl__date { display: grid; }
  .rr-dl__date b { font-variant-numeric: tabular-nums; }
  .rr-dl__date span { font-size: 12px; color: var(--muted); }
  .rr-dl__what { display: grid; gap: 2px; grid-column: 1 / -1; grid-row: 2; }
  @media (min-width: 640px) { .rr-dl__what { grid-column: 2; grid-row: 1; } }
  .rr-dl .badge { grid-column: 2; grid-row: 1; justify-self: end; }
  @media (min-width: 640px) { .rr-dl .badge { grid-column: 3; } }
  .rr-nums { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; margin: 0; }
  .rr-nums div { background: var(--surface); border-radius: 12px; padding: 12px 14px; }
  .rr-nums dt { font-size: 12px; color: var(--muted); }
  .rr-nums dd { margin: 2px 0 0; font-family: var(--font-display); font-size: 1.35rem; font-weight: 600; color: var(--plum-700); }
  .rr-intl { background: var(--plum-50); border-radius: 14px; padding: 16px 18px; }
  .rr-intl h3 { color: var(--plum-700); }
  .rr-intl ul { margin: 0; padding-left: 18px; display: grid; gap: 8px; }
  .rr-links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .rr-links a { display: inline-flex; align-items: center; gap: 6px; padding: 8px 12px; border-radius: 10px; border: 1px solid var(--line); font-size: 14px; font-weight: 600; color: var(--ink); text-decoration: none; }
  .rr-links a:hover { border-color: var(--plum-600); color: var(--plum-700); }
  .rr-links :global(svg) { width: 15px; height: 15px; flex: none; }
  .rr-src { margin: 18px 0 0; overflow-wrap: anywhere; }

  .rr-side { display: grid; gap: 18px; }
  .rr-help { border-radius: 20px; padding: 24px; color: #efe8f8; background: radial-gradient(120% 120% at 100% 0%, #5b1d8f 0%, #1c0a33 60%); }
  .rr-help .eyebrow { color: var(--coral); }
  .rr-help h2 { font-family: var(--font-display); font-size: 1.45rem; color: #fff; margin: 6px 0 8px; line-height: 1.2; }
  .rr-help p { color: rgba(239,232,248,.85); }
  .rr-nat { padding: 20px; }
  .side-h { font-size: 13px; font-weight: 750; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); margin: 0 0 12px; }
  .rr-nat dl { display: grid; gap: 8px; margin: 0 0 10px; }
  .rr-nat dl div { display: flex; justify-content: space-between; gap: 10px; font-size: 14px; }
  .rr-nat dt { color: var(--muted); }
  .rr-nat dd { margin: 0; font-weight: 700; font-variant-numeric: tabular-nums; }

  .rr-more { background: var(--surface); }
  .rr-others { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .rr-others a { display: inline-block; padding: 8px 14px; border-radius: 999px; background: #fff; border: 1px solid var(--line); font-weight: 600; font-size: 14px; color: var(--ink); text-decoration: none; }
  .rr-others a:hover { border-color: var(--plum-600); color: var(--plum-700); }
</style>
