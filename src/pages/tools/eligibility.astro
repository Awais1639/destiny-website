---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import '../../styles/tools.css';
import { scholarships, url } from '../../lib/data';
import { getStatus, statusText, fundingLabel } from '../../lib/scholarships';
import { countryBySlug } from '../../data/countries';
import elig from '../../data/eligibility.json';
import world from '../../data/world-countries.json';
const countriesList = world as [string, string][];

const rules = (elig as any).rules as Record<string, any>;
const items = scholarships.map((s) => {
  const st = getStatus(s);
  return {
    slug: s.slug,
    title: s.title,
    href: url(`/scholarships/${s.slug}/`),
    where: s.countries.map((c) => countryBySlug[c]?.name ?? c).join(', '),
    levels: s.degreeLevels,
    funding: fundingLabel(s.fundingType),
    status: statusText(st, s.dates.deadline),
    closed: st === 'closed',
    rule: rules[s.slug] ?? { pk: 'list' },
  };
});
---
<BaseLayout title="Scholarship eligibility checker" description={`Answer a few questions and see which of ${items.length} major scholarships you meet the published requirements for — age limits, nationality, grades, English and work experience, checked against official sources.`}>
  <PageHero
    variant="light"
    eyebrow="Tools"
    title="Scholarship eligibility checker"
    lead={`Answer eight quick questions. We compare your answers with the published requirements of ${items.length} major government and university scholarships and show where you qualify, where you should check, and why.`}
    crumbs={[{ label: 'Tools', href: '/tools/' }, { label: 'Eligibility checker' }]}
  />

  <section class="section-tight">
    <div class="container tool-wrap tool-wrap--split">
      <form class="tool-form tool-form--sticky" data-el-form novalidate>
        <h2>Your details</h2>
        <div class="tf-row"><label for="el-nat">Nationality</label>
          <select id="el-nat" name="nat">{countriesList.map(([c, n]) => <option value={c} selected={c === 'PK'}>{n}</option>)}</select></div>
        <div class="tf-row"><label for="el-live">Country you live in</label>
          <select id="el-live" name="live">{countriesList.map(([c, n]) => <option value={c} selected={c === 'PK'}>{n}</option>)}</select></div>
        <div class="tf-row"><label for="el-target">You want to study</label>
          <select id="el-target" name="target"><option value="masters">Master's</option><option value="phd">PhD</option><option value="bachelors">Bachelor's</option></select></div>
        <div class="tf-row"><label for="el-high">Highest qualification you have completed</label>
          <select id="el-high" name="high">
            <option value="12">Intermediate / FSc / A-levels (12 years)</option>
            <option value="14">Bachelor's — 14 years (2-year BA / BSc)</option>
            <option value="16" selected>Bachelor's — 16 years (BS / 4-year degree)</option>
            <option value="18">Master's (MS / MPhil / 18 years)</option>
            <option value="21">PhD</option>
          </select></div>
        <div class="tf-row"><label for="el-gtype">Grading scale</label>
          <select id="el-gtype" name="gtype">
            <option value="cgpa4">CGPA / GPA out of 4.00 (Pakistan, USA and others)</option>
            <option value="cgpa43">CGPA out of 4.30</option>
            <option value="cgpa45">CGPA out of 4.50</option>
            <option value="cgpa5">CGPA out of 5.00</option>
            <option value="cgpa10">CGPA out of 10 (e.g. India, Nepal)</option>
            <option value="pct">Percentage (out of 100)</option>
            <option value="uk">UK degree classification (First, 2:1, 2:2…)</option>
            <option value="de">German grade (1.0 best – 4.0 pass)</option>
            <option value="it110">Italian degree mark (out of 110)</option>
            <option value="fr20">French grade (out of 20)</option>
            <option value="es10">Grade out of 10 (Spain, Latin America)</option>
            <option value="ru5">5-point scale (Russia, Central Asia)</option>
            <option value="other">Other scale</option>
          </select></div>
        <div class="tf-row"><label for="el-grade" data-el-glabel>Your grade (out of 4.00)</label>
          <input id="el-grade" name="grade" type="number" step="0.01" min="0" inputmode="decimal" placeholder="3.40" />
          <select id="el-uk" name="uk" hidden><option value="">Choose…</option><option value="5">First-class honours</option><option value="4">Upper second (2:1)</option><option value="3">Lower second (2:2)</option><option value="2">Third-class honours</option><option value="1">Pass / ordinary degree</option></select>
          <small>Leave empty if you don't know yet.</small></div>
        <div class="tf-row"><label for="el-dob">Date of birth</label>
          <input id="el-dob" name="dob" type="date" required /></div>
        <div class="tf-row"><label for="el-eng">English proficiency</label>
          <select id="el-eng" name="eng">
            <option value="">No test or proof yet</option>
            <option value="ielts">IELTS Academic</option>
            <option value="toefl">TOEFL iBT</option>
            <option value="pte">PTE Academic</option>
            <option value="duolingo">Duolingo English Test</option>
            <option value="cambridge">Cambridge English (B2 First / C1 Advanced / C2 Proficiency)</option>
            <option value="languagecert">LanguageCert Academic</option>
            <option value="oxford">Oxford Test of English</option>
            <option value="password">Password Skills Plus</option>
            <option value="met">Michigan English Test (MET)</option>
            <option value="toeflitp">TOEFL ITP / TOEFL Essentials</option>
            <option value="othertest">Other English test</option>
            <option value="moi">Medium of Instruction (MOI) — my degree was taught in English</option>
          </select></div>
        <div class="tf-row" data-el-engrow hidden><label for="el-engs" data-el-englabel>Overall score</label>
          <input id="el-engs" name="engs" type="number" step="0.5" min="0" inputmode="decimal" /></div>
        <div class="tf-row"><label for="el-work">Years of full-time work experience</label>
          <input id="el-work" name="work" type="number" min="0" max="50" step="0.5" value="0" inputmode="decimal" /></div>
        <p class="tf-err" data-el-err aria-live="polite"></p>
        <button class="btn btn-primary" type="submit">Check my eligibility</button>
        <small class="tf-hint">Your answers stay in your browser — nothing is sent or saved.</small>
      </form>

      <div class="tool-result" data-el-out aria-live="polite">
        <div class="tool-note">
          <strong>How this works.</strong> Each scholarship's age limits, nationality rules, minimum grades, English scores and work-experience requirements are taken from its official page (the same sources shown on each scholarship page). When an official source doesn't state a rule, we show <em>check</em> instead of guessing. Meeting the published requirements does <strong>not</strong> mean you will be selected — selection is competitive and decided only by the provider.
        </div>
      </div>
    </div>
  </section>

  <CtaBand title="Want an expert to review your profile?" text="Our consultancy team can check your documents and suggest the strongest scholarships for your profile. Optional and separate from official applications." />
</BaseLayout>

<script type="application/json" id="el-data" set:html={JSON.stringify(items)}></script>
<script>
  type Rule = { pk: string; natList?: string[]; natExcept?: string[]; natNote?: string; residence?: string; ageMax?: Record<string, number>; ageMin?: number; birthMin?: Record<string, number>; minPct?: Record<string, number>; minCgpa4?: Record<string, number>; minOther?: Record<string, number>; minUK?: string; work?: number; eng?: Record<string, number>; engAlt?: string; engMoi?: boolean; prior?: string; nomination?: boolean; gradeNote?: string; workNote?: string; ageNote?: string };
  type Item = { slug: string; title: string; href: string; where: string; levels: string[]; funding: string; status: string; closed: boolean; rule: Rule };
  const data: Item[] = JSON.parse(document.getElementById('el-data')!.textContent!);
  const form = document.querySelector<HTMLFormElement>('[data-el-form]')!;
  const out = document.querySelector<HTMLElement>('[data-el-out]')!;
  const err = document.querySelector<HTMLElement>('[data-el-err]')!;
  const $ = <T extends HTMLElement>(q: string) => form.querySelector<T>(q)!;
  const gtype = $<HTMLSelectElement>('#el-gtype'), grade = $<HTMLInputElement>('#el-grade'), ukSel = $<HTMLSelectElement>('#el-uk'), glabel = $<HTMLElement>('[data-el-glabel]');
  const engSel = $<HTMLSelectElement>('#el-eng'), engRow = $<HTMLElement>('[data-el-engrow]'), engS = $<HTMLInputElement>('#el-engs'), engLabel = $<HTMLElement>('[data-el-englabel]');
  const SCALES: Record<string, { label: string; min: number; max: number; ph: string; step: string; lowerBetter?: boolean }> = {
    cgpa4: { label: 'Your grade (out of 4.00)', min: 0, max: 4, ph: '3.40', step: '0.01' },
    cgpa43: { label: 'Your grade (out of 4.30)', min: 0, max: 4.3, ph: '3.50', step: '0.01' },
    cgpa45: { label: 'Your grade (out of 4.50)', min: 0, max: 4.5, ph: '3.60', step: '0.01' },
    cgpa5: { label: 'Your grade (out of 5.00)', min: 0, max: 5, ph: '4.00', step: '0.01' },
    cgpa10: { label: 'Your grade (out of 10)', min: 0, max: 10, ph: '7.5', step: '0.01' },
    pct: { label: 'Your percentage', min: 0, max: 100, ph: '72', step: '0.01' },
    de: { label: 'Your German grade (1.0 best)', min: 1, max: 5, ph: '2.3', step: '0.1', lowerBetter: true },
    it110: { label: 'Your degree mark (out of 110)', min: 0, max: 110, ph: '100', step: '1' },
    fr20: { label: 'Your grade (out of 20)', min: 0, max: 20, ph: '13', step: '0.01' },
    es10: { label: 'Your grade (out of 10)', min: 0, max: 10, ph: '7.5', step: '0.01' },
    ru5: { label: 'Your grade (out of 5)', min: 0, max: 5, ph: '4.5', step: '0.01' },
    other: { label: 'Your grade', min: 0, max: 100000, ph: '', step: 'any' },
  };
  const TESTS: Record<string, { name: string; min: number; max: number; step: string; ph: string; label?: string }> = {
    ielts: { name: 'IELTS', min: 0, max: 9, step: '0.5', ph: '6.5', label: 'Overall band (0–9)' },
    toefl: { name: 'TOEFL iBT', min: 0, max: 120, step: '1', ph: '90', label: 'Total score (0–120)' },
    pte: { name: 'PTE Academic', min: 10, max: 90, step: '1', ph: '65', label: 'Overall score (10–90)' },
    duolingo: { name: 'Duolingo English Test', min: 10, max: 160, step: '5', ph: '115', label: 'Overall score (10–160)' },
    cambridge: { name: 'Cambridge English', min: 80, max: 230, step: '1', ph: '180', label: 'Cambridge English Scale score (80–230)' },
    languagecert: { name: 'LanguageCert Academic', min: 0, max: 100, step: '1', ph: '70', label: 'Overall score' },
    oxford: { name: 'Oxford Test of English', min: 0, max: 170, step: '1', ph: '125', label: 'Overall score' },
    password: { name: 'Password Skills Plus', min: 0, max: 9, step: '0.5', ph: '6.5', label: 'Overall score' },
    met: { name: 'Michigan English Test', min: 0, max: 80, step: '1', ph: '55', label: 'Overall score' },
    toeflitp: { name: 'TOEFL ITP / Essentials', min: 0, max: 677, step: '1', ph: '', label: 'Overall score' },
    othertest: { name: 'your English test', min: 0, max: 100000, step: 'any', ph: '', label: 'Overall score' },
  };
  function syncGrade() {
    const sc = gtype.value;
    if (sc === 'uk') { grade.hidden = true; ukSel.hidden = false; glabel.textContent = 'Your classification'; glabel.setAttribute('for', 'el-uk'); return; }
    grade.hidden = false; ukSel.hidden = true; glabel.setAttribute('for', 'el-grade');
    const c = SCALES[sc]; glabel.textContent = c.label; grade.placeholder = c.ph; grade.step = c.step; grade.min = String(c.min); grade.max = String(c.max);
  }
  function syncEng() {
    const t = TESTS[engSel.value];
    engRow.hidden = !t; if (!t) return;
    engLabel.textContent = t.label ?? 'Overall score'; engS.placeholder = t.ph; engS.step = t.step; engS.min = String(t.min); engS.max = String(t.max);
  }
  gtype.addEventListener('change', () => { grade.value = ''; ukSel.value = ''; syncGrade(); });
  engSel.addEventListener('change', () => { engS.value = ''; syncEng(); });
  syncGrade(); syncEng();
  form.addEventListener('input', () => { err.textContent = ''; });
  const levelName: Record<string, string> = { bachelors: "bachelor's", masters: "master's", phd: 'PhD' };
  const UKN: Record<string, number> = { First: 5, '2:1': 4, '2:2': 3, Third: 2, Pass: 1 };
  const UKL = ['', 'a pass', 'a third', 'a 2:2', 'a 2:1', 'a first'];
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const pick = (m: Record<string, number> | undefined, lvl: string) => (m ? (m[lvl] ?? m.any) : undefined);
  const cname = (code: string) => (form.querySelector<HTMLOptionElement>(`#el-nat option[value="${code}"]`)?.textContent ?? code);
  function ageOn(dob: Date, d = new Date()) { let a = d.getFullYear() - dob.getFullYear(); const m = d.getMonth() - dob.getMonth(); if (m < 0 || (m === 0 && d.getDate() < dob.getDate())) a--; return a; }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = new FormData(form);
    const nat = String(f.get('nat')), live = String(f.get('live')), target = String(f.get('target')), high = Number(f.get('high'));
    const sc = gtype.value;
    const dobS = String(f.get('dob') || '');
    const eng = engSel.value, es = Number(engS.value || 0), work = Number(f.get('work') || 0);
    if (!dobS) { err.textContent = 'Enter your date of birth first.'; $<HTMLInputElement>('#el-dob').focus(); return; }
    const dob = new Date(dobS + 'T00:00:00');
    const age = ageOn(dob);
    if (isNaN(age) || age < 14 || age > 80) { err.textContent = 'Check your date of birth.'; return; }
    let g: number | null = null;
    if (sc === 'uk') g = ukSel.value ? Number(ukSel.value) : null;
    else if (grade.value.trim() !== '') {
      g = Number(grade.value); const c = SCALES[sc];
      if (isNaN(g) || g < c.min || g > c.max) { err.textContent = `Enter a grade between ${c.min} and ${c.max}.`; return; }
    }
    const T = TESTS[eng];
    if (T && !engS.value) { err.textContent = `Enter your ${T.name} score, or choose "No test or proof yet".`; return; }
    if (T && (es < T.min || es > T.max)) { err.textContent = `${T.name} scores go from ${T.min} to ${T.max}.`; return; }
    const natName = cname(nat);

    const res = data.filter((it) => it.levels.includes(target)).map((it) => {
      const r = it.rule; const c: { k: 'ok' | 'no' | 'q' | 'i'; t: string }[] = [];
      // nationality
      if (r.natList) {
        if (r.natList.includes(nat)) c.push({ k: 'ok', t: `${natName} is on the official country list` });
        else c.push({ k: r.natNote ? 'q' : 'no', t: `${natName} is not on the official country list${r.natNote ? ` — ${r.natNote}` : ''}` });
      } else if (r.natExcept) {
        if (r.natExcept.includes(nat)) c.push({ k: 'no', t: `Not open to citizens of ${natName}` });
        else c.push({ k: 'ok', t: nat === 'PK' ? 'Pakistani citizens are eligible' : `Open to international applicants, including ${natName}` });
      } else if (nat === 'PK') {
        if (r.pk === 'yes' || r.pk === 'only') c.push({ k: 'ok', t: 'Pakistani citizens are eligible' });
        else if (r.pk === 'no') c.push({ k: 'no', t: 'Pakistan is not on the official country list for this cycle' });
        else c.push({ k: 'q', t: 'Depends on the official country list for the cycle — check Pakistan is included' });
      } else {
        c.push(r.pk === 'only' ? { k: 'no', t: 'Only for Pakistani citizens' } : { k: 'q', t: `Check whether ${natName} is on the official country list` });
      }
      // residence
      if (r.residence === 'pk') c.push(live === 'PK' ? { k: 'ok', t: 'You live in Pakistan' } : { k: 'no', t: 'You must live in and apply from Pakistan' });
      if (r.residence === 'home') c.push(live === nat ? { k: 'ok', t: 'You live in your home country' } : { k: 'q', t: 'You must be permanently resident in an eligible country' });
      if (r.residence === 'notSaudi') c.push(live === 'SA' ? { k: 'no', t: 'Applicants living in Saudi Arabia cannot apply' } : { k: 'ok', t: 'Not living in Saudi Arabia' });
      // prior degree
      if (target === 'bachelors') c.push(high >= 12 ? { k: 'ok', t: 'You have completed school (12 years)' } : { k: 'no', t: 'Needs completed secondary school' });
      if (target === 'masters') {
        if (high >= 16) c.push({ k: 'ok', t: "You hold a bachelor's degree" });
        else if (high === 14) c.push({ k: 'q', t: "Many programmes need a 16-year bachelor's — check whether a 14-year degree is accepted" });
        else c.push({ k: 'no', t: "Needs a completed bachelor's degree" });
      }
      if (target === 'phd') {
        if (high >= 18) c.push({ k: 'ok', t: "You hold a master's degree" });
        else if (high === 16 && r.prior !== 'masters') c.push({ k: 'q', t: "Most PhD routes need a master's — some accept a 4-year bachelor's" });
        else c.push({ k: 'no', t: "Needs a completed master's degree" });
      }
      // age
      const max = pick(r.ageMax, target);
      if (max !== undefined) c.push(age <= max ? { k: 'ok', t: `Age ${age} — limit ${max}` } : { k: 'no', t: `Age ${age} — the limit is ${max}` });
      if (r.ageMin !== undefined) c.push(age >= r.ageMin ? { k: 'ok', t: `Minimum age ${r.ageMin}` } : { k: 'no', t: `Minimum age is ${r.ageMin}` });
      const bmin = pick(r.birthMin, target);
      if (bmin !== undefined) c.push(dob.getFullYear() >= bmin ? { k: 'ok', t: `Born in ${bmin} or later` } : { k: 'no', t: `Must be born in ${bmin} or later` });
      if (r.ageNote) c.push({ k: 'q', t: r.ageNote });
      // grade
      const mp = pick(r.minPct, target), mc = pick(r.minCgpa4, target);
      const req: Record<string, number> = { ...(r.minOther ?? {}) };
      if (mc !== undefined) req.cgpa4 = mc; if (mp !== undefined) req.pct = mp;
      if (r.minUK) req.uk = UKN[r.minUK];
      if (Object.keys(req).length) {
        const parts = [req.cgpa4 !== undefined ? `CGPA ${req.cgpa4.toFixed(2)}/4` : '', req.pct !== undefined ? `${req.pct}%` : '', r.minUK ? `a ${r.minUK} degree` : '', ...Object.entries(r.minOther ?? {}).map(([k, v]) => `${v.toFixed(2)}/${({ cgpa43: '4.3', cgpa45: '4.5', cgpa5: '5.0' } as Record<string, string>)[k] ?? k}`)].filter(Boolean);
        const need = parts.join(' or ');
        if (g === null) c.push({ k: 'q', t: `Minimum grade: ${need}` });
        else if (req[sc] !== undefined) {
          const ok = g >= req[sc];
          const fmtG = (v: number) => sc === 'uk' ? UKL[v] : sc === 'pct' ? `${v}%` : sc.startsWith('cgpa') ? v.toFixed(2) : String(v);
          const shown = fmtG(g), want = fmtG(req[sc]);
          const soft = !ok && sc === 'uk' && !!r.gradeNote && g === req[sc] - 1;
          c.push(ok ? { k: 'ok', t: `Your grade ${shown} — minimum ${want}` } : { k: soft ? 'q' : 'no', t: `Your grade ${shown} — minimum is ${want}${soft ? ' (see the exception below)' : ''}` });
        } else c.push({ k: 'q', t: `Minimum grade: ${need} — the official source gives no equivalent for your grading scale, so check how your grade is assessed` });
      }
      if (r.gradeNote) c.push({ k: 'q', t: r.gradeNote });
      // work
      if (r.work !== undefined) c.push(work >= r.work ? { k: 'ok', t: `${work} years' work experience — needs ${r.work}` } : { k: 'no', t: `Needs ${r.work} years' work experience (you have ${work})` });
      if (r.workNote) c.push({ k: 'q', t: r.workNote });
      // english
      if (r.eng) {
        const names: Record<string, string> = { ielts: 'IELTS', toefl: 'TOEFL iBT', pte: 'PTE' };
        const need = Object.entries(r.eng).map(([k, v]) => `${names[k]} ${v}`).join(', ') + (r.engAlt ? ` ${r.engAlt}` : '');
        if (eng === 'moi') c.push(r.engMoi ? { k: 'ok', t: 'A degree taught in English is accepted' } : { k: 'q', t: `MOI is not listed as accepted — required: ${need}` });
        else if (eng && r.eng[eng] !== undefined) c.push(es >= r.eng[eng] ? { k: 'ok', t: `${names[eng]} ${es} — minimum ${r.eng[eng]}` } : { k: 'no', t: `${names[eng]} ${es} — minimum is ${r.eng[eng]}${r.engAlt ? ` (${r.engAlt})` : ''}` });
        else if (T) c.push({ k: 'q', t: `Check whether ${T.name} is accepted — official requirement: ${need}` });
        else c.push({ k: 'q', t: `English: ${need}` });
      }
      if (r.nomination) c.push({ k: 'i', t: 'Selection is through nomination — apply via the route on the official page' });
      if (it.closed) c.push({ k: 'i', t: 'Closed for this cycle — useful for planning next year' });
      const verdict = c.some((x) => x.k === 'no') ? 'no' : c.some((x) => x.k === 'q') ? 'check' : 'ok';
      return { it, c, verdict };
    });

    const groups: [string, string, string][] = [['ok', 'You meet the published requirements', 'ok'], ['check', 'Possible — check these points', 'check'], ['no', 'Not eligible on the published rules', 'no']];
    const sym: Record<string, string> = { ok: '✓', no: '✗', q: '?', i: 'i' };
    let html = `<p class="tr-meta">${res.length} scholarships offer ${levelName[target]} study. Checked against official requirements — always confirm on the official page before applying.</p>`;
    for (const [key, label, cls] of groups) {
      const list = res.filter((x) => x.verdict === key);
      if (!list.length) continue;
      html += `<section class="tr-group"><h3>${label} <span>${list.length}</span></h3><div class="tool-result">`;
      for (const { it, c } of list) {
        html += `<article class="tr-card tr-card--${cls}"><div class="tr-head"><a href="${it.href}">${esc(it.title)}</a><span class="tr-meta">${esc(it.where)} · ${esc(it.funding)} · ${esc(it.status)}</span></div>`;
        html += `<ul class="tr-checks">${c.map((x) => `<li class="${x.k}"><b aria-hidden="true">${sym[x.k]}</b><span>${esc(x.t)}</span></li>`).join('')}</ul></article>`;
      }
      html += `</div></section>`;
    }
    if (!res.length) html += `<p>No scholarships in our list cover this level yet.</p>`;
    out.innerHTML = html;
    if (window.innerWidth < 980) out.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>
