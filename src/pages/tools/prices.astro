---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import '../../styles/tools.css';
import { site } from '../../config/site';
const prices = site.prices;
---
<BaseLayout title="Consultancy service prices" description="Transparent prices for Destiny Global Solutions consultancy services: scholarship applications, admissions, document review and visa guidance." noindex={!prices.length}>
  <PageHero variant="light" eyebrow="Tools" title="Service prices" lead="Our consultancy services are optional — you can always apply directly on the official websites for free." crumbs={[{ label: 'Tools', href: '/tools/' }, { label: 'Prices' }]} />
  <section class="section-tight"><div class="container" style="max-width:820px">
    {prices.length ? (
      <table class="tool-table"><thead><tr><th>Service</th><th>Price</th><th>Notes</th></tr></thead>
        <tbody>{prices.map((p) => <tr><td><b>{p.service}</b></td><td>{p.price}</td><td>{p.note ?? ''}</td></tr>)}</tbody></table>
    ) : (
      <div class="tool-note">Prices are shared on request — send us a free inquiry and we'll reply with a quote for your case.</div>
    )}
  </div></section>
  <CtaBand />
</BaseLayout>
