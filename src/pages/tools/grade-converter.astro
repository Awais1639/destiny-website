---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import '../../styles/tools.css';
---
<BaseLayout title="Grade converter — CGPA or percentage to the German grade" description="Convert your CGPA or percentage to the German grading scale (1.0–4.0) with the modified Bavarian formula used by German universities and uni-assist. Free, instant and private.">
  <PageHero
    variant="light"
    eyebrow="Tools"
    title="Grade converter"
    lead="See what your CGPA or percentage is on the German scale (1.0 best, 4.0 lowest pass), using the “modified Bavarian formula” that German universities use for foreign grades."
    crumbs={[{ label: 'Tools', href: '/tools/' }, { label: 'Grade converter' }]}
  />

  <section class="section-tight">
    <div class="container tool-wrap tool-wrap--split">
      <form class="tool-form" data-gc-form novalidate>
        <h2>Your grading system</h2>
        <div class="tf-row"><label for="gc-preset">Grade type</label>
          <select id="gc-preset"><option value="cgpa">CGPA out of 4.00</option><option value="pct">Percentage (out of 100)</option><option value="custom">Other scale</option></select></div>
        <div class="tf-2">
          <div class="tf-row"><label for="gc-max">Best possible grade</label><input id="gc-max" type="number" step="0.01" inputmode="decimal" value="4" /></div>
          <div class="tf-row"><label for="gc-min">Lowest passing grade</label><input id="gc-min" type="number" step="0.01" inputmode="decimal" placeholder="from your transcript" /></div>
        </div>
        <small class="tf-hint">The lowest passing grade is printed on your transcript or in your university's grading rules. German universities take it from <a href="https://anabin.kmk.org/" target="_blank" rel="noopener noreferrer">anabin</a>, the official database for foreign qualifications.</small>
        <div class="tf-row"><label for="gc-you">Your grade</label><input id="gc-you" type="number" step="0.01" inputmode="decimal" placeholder="3.40" /></div>
        <p class="tf-err" data-gc-err aria-live="polite"></p>
        <button class="btn btn-primary" type="submit">Convert</button>
      </form>

      <div class="tool-out" aria-live="polite">
        <p class="tr-meta">Your German grade</p>
        <p class="tool-big" data-gc-out>–</p>
        <p data-gc-band class="small muted">Enter your grades to see the result.</p>
        <hr style="border:0;border-top:1px solid var(--line);margin:18px 0" />
        <h2 style="font-size:17px">The formula</h2>
        <p class="small">German grade = 1 + 3 × (best grade − your grade) ÷ (best grade − lowest passing grade)</p>
        <table class="tool-table">
          <thead><tr><th>German grade</th><th>Meaning</th></tr></thead>
          <tbody>
            <tr><td>1.0 – 1.5</td><td>very good (sehr gut)</td></tr>
            <tr><td>1.6 – 2.5</td><td>good (gut)</td></tr>
            <tr><td>2.6 – 3.5</td><td>satisfactory (befriedigend)</td></tr>
            <tr><td>3.6 – 4.0</td><td>sufficient (ausreichend)</td></tr>
          </tbody>
        </table>
        <div class="tool-note" style="margin-top:16px">
          <strong>For guidance only.</strong> The official conversion is done by the university or uni-assist using anabin values, and some universities truncate rather than round. Use this to see roughly where you stand, then compare it with the minimum grade on each programme's admission page.
        </div>
        <p class="small muted" style="margin-top:12px">Sources: <a href="https://www.tum.de/en/studies/application/grade-conversion-formula-for-grades-earned-outside-germany" target="_blank" rel="noopener noreferrer">TUM — grade conversion (modified Bavarian formula)</a> · <a href="https://www.hs-duesseldorf.de/studium/internationales/Documents/GPA.pdf" target="_blank" rel="noopener noreferrer">HS Düsseldorf — conversion by uni-assist</a></p>
      </div>
    </div>
  </section>
  <CtaBand title="Planning to study in Germany?" text="Browse DAAD-listed English-taught programmes in our course finder, or ask our team to check your documents before you apply." />
</BaseLayout>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-gc-form]')!;
  const preset = f.querySelector<HTMLSelectElement>('#gc-preset')!;
  const max = f.querySelector<HTMLInputElement>('#gc-max')!, min = f.querySelector<HTMLInputElement>('#gc-min')!, you = f.querySelector<HTMLInputElement>('#gc-you')!;
  const out = document.querySelector<HTMLElement>('[data-gc-out]')!, band = document.querySelector<HTMLElement>('[data-gc-band]')!, err = document.querySelector<HTMLElement>('[data-gc-err]')!;
  preset.addEventListener('change', () => {
    if (preset.value === 'cgpa') { max.value = '4'; you.placeholder = '3.40'; }
    else if (preset.value === 'pct') { max.value = '100'; you.placeholder = '72'; }
    else { max.value = ''; you.placeholder = ''; }
    min.value = '';
  });
  f.addEventListener('input', () => { err.textContent = ''; });
  f.addEventListener('submit', (e) => {
    e.preventDefault();
    const a = Number(max.value), b = Number(min.value), d = Number(you.value);
    if (!max.value || !min.value || !you.value) { err.textContent = 'Fill in all three grades.'; return; }
    if (!(a > b)) { err.textContent = 'The best grade must be higher than the lowest passing grade.'; return; }
    if (d < b || d > a) { err.textContent = 'Your grade must be between the lowest passing grade and the best grade.'; return; }
    const x = 1 + 3 * (a - d) / (a - b);
    out.textContent = (Math.floor(x * 10) / 10).toFixed(1);
    band.textContent = `Exact value ${x.toFixed(2)} — ` + (x <= 1.5 ? 'very good' : x <= 2.5 ? 'good' : x <= 3.5 ? 'satisfactory' : 'sufficient') + ' on the German scale.';
  });
</script>
