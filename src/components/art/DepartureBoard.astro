---
/** Split-flap "departures board" listing real upcoming scholarship deadlines (Scholarship Explorer hero). */
import { scholarships, url } from '../../lib/data';
import { getStatus, sortScholarships, formatDate } from '../../lib/scholarships';
import { countryBySlug } from '../../data/countries';

const rows = sortScholarships(scholarships, 'deadline').slice(0, 6).map((s) => {
  const st = getStatus(s);
  const c = countryBySlug[s.countries[0]];
  const short = s.program.replace(/\(.*?\)/g, '').trim().toUpperCase();
  const deadline = s.dates.deadline ? formatDate(s.dates.deadline).toUpperCase() : st === 'varies' ? 'VARIES' : 'TBC';
  const status = { open: 'OPEN', 'closing-soon': 'FINAL CALL', upcoming: 'SOON', closed: 'CLOSED', varies: 'VARIES', unconfirmed: 'TBC' }[st];
  return { href: url(`/scholarships/${s.slug}/`), code: c?.code ?? '--', prog: short.slice(0, 22), deadline, status, st, title: s.title };
});
const pad = (t: string, n: number) => (t + ' '.repeat(n)).slice(0, n);
---
<div class="board" data-board>
  <div class="board__head">
    <span class="board__title"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2Z"/></svg> Departures</span>
    <span class="board__clock" data-clock aria-hidden="true">--:--</span>
  </div>
  <div class="board__cols" aria-hidden="true"><span>To</span><span>Programme</span><span>Deadline</span><span>Status</span></div>
  <ul class="board__rows">
    {rows.map((r, i) => (
      <li>
        <a href={r.href} class={`brow brow--${r.st}`} style={`--r:${i}`} aria-label={`${r.title}: deadline ${r.deadline}, ${r.status}`}>
          <span class="cell cell--code" data-flap={pad(r.code, 2)} aria-hidden="true">{pad(r.code, 2)}</span>
          <span class="cell cell--prog" data-flap={pad(r.prog, 22)} aria-hidden="true">{pad(r.prog, 22)}</span>
          <span class="cell cell--date" data-flap={pad(r.deadline, 11)} aria-hidden="true">{pad(r.deadline, 11)}</span>
          <span class="cell cell--st" data-flap={pad(r.status, 10)} aria-hidden="true">{pad(r.status, 10)}</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .board { position: relative; background: linear-gradient(180deg, #120620, #0b0315); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 14px; padding: 14px; box-shadow: 0 30px 60px -24px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.06); font-family: ui-monospace, 'SFMono-Regular', Consolas, 'Liberation Mono', monospace; }
  .board__head { display: flex; justify-content: space-between; align-items: center; padding: 2px 4px 12px; color: var(--coral); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; font-size: 13px; }
  .board__title { display: inline-flex; align-items: center; gap: 8px; }
  .board__clock { color: #efe8f8; letter-spacing: 0.1em; font-variant-numeric: tabular-nums; }
  .board__cols, .brow { display: grid; grid-template-columns: 3ch minmax(0, 1fr) 12ch 11ch; gap: 8px; align-items: center; }
  .board__cols { padding: 0 8px 6px; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: #9280b0; }
  .board__rows { list-style: none; display: grid; gap: 6px; }
  .brow { padding: 7px 8px; border-radius: 6px; background: rgba(255, 255, 255, 0.03); text-decoration: none; color: #f4eeff; font-size: 12.5px; transition: background 0.2s, transform 0.2s; }
  .brow:hover { background: rgba(255, 107, 95, 0.12); transform: translateX(4px); color: #fff; }
  .cell { display: block; white-space: pre; overflow: hidden; text-overflow: clip; }
  .cell :global(b) { display: inline-block; min-width: 1ch; text-align: center; background: linear-gradient(180deg, #24123a 0 49%, #1a0b2c 51% 100%); border-radius: 2px; margin-right: 1px; font-weight: 700; color: inherit; }
  .cell :global(b.flip) { animation: flap 90ms linear; }
  @keyframes flap { 0% { transform: rotateX(0); } 50% { transform: rotateX(90deg); filter: brightness(1.6); } 100% { transform: rotateX(0); } }
  .cell--code { color: var(--coral); font-weight: 800; }
  .cell--st { font-weight: 700; }
  .brow--open .cell--st { color: #4ade9b; }
  .brow--closing-soon .cell--st { color: #ffcf6b; animation: blink 1.4s steps(2, start) infinite; }
  .brow--closed .cell--st { color: #ff8a80; }
  .brow--varies .cell--st, .brow--unconfirmed .cell--st, .brow--upcoming .cell--st { color: #c6b0ec; }
  @keyframes blink { to { opacity: 0.45; } }
  @media (max-width: 520px) {
    .board__cols, .brow { grid-template-columns: 3ch minmax(0, 1fr) 12ch; }
    .board__cols span:nth-child(4), .cell--st { display: none; }
    .brow { font-size: 10.5px; padding: 6px; }
    .board__cols { font-size: 9px; }
  }
  @media (prefers-reduced-motion: reduce) { .brow--closing-soon .cell--st { animation: none; } }
</style>

<script>
  const board = document.querySelector<HTMLElement>('[data-board]');
  if (board) {
    const clock = board.querySelector('[data-clock]');
    const tick = () => { if (clock) clock.textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }); };
    tick(); setInterval(tick, 15000);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const GL = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
    board.querySelectorAll<HTMLElement>('[data-flap]').forEach((cell, ci) => {
      const target = cell.dataset.flap!;
      cell.textContent = '';
      const chars = [...target].map((ch) => { const b = document.createElement('b'); b.textContent = reduced ? ch : ' '; cell.appendChild(b); return { b, ch }; });
      if (reduced) return;
      const row = Number(cell.closest<HTMLElement>('.brow')?.style.getPropertyValue('--r') || 0);
      chars.forEach(({ b, ch }, i) => {
        let n = 4 + Math.floor(Math.random() * 6);
        const step = () => {
          b.classList.remove('flip'); void b.offsetWidth; b.classList.add('flip');
          if (n-- <= 0 || ch === ' ') { b.textContent = ch; return; }
          b.textContent = GL[Math.floor(Math.random() * GL.length)];
          setTimeout(step, 70);
        };
        setTimeout(step, 300 + row * 160 + (ci % 4) * 60 + i * 22);
      });
    });
  }
</script>
