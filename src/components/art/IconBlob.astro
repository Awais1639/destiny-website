---
/** Service detail hero art: large service icon inside a glowing, morphing blob with orbiting dots. */
import Icon from '../Icon.astro';
interface Props { icon: string; steps: number }
const { icon, steps } = Astro.props;
---
<div class="iblob" aria-hidden="true">
  <div class="iblob__shape"></div>
  <div class="iblob__ring"><i></i><i></i><i></i></div>
  <div class="iblob__icon"><Icon name={icon} size={88} /></div>
  <div class="iblob__steps">{Array.from({ length: steps }, (_, i) => <span style={`--i:${i}`}>{String(i + 1).padStart(2, '0')}</span>)}</div>
</div>
<style>
  .iblob { position: relative; width: min(100%, 380px); aspect-ratio: 1; margin-inline: auto; display: grid; place-items: center; }
  .iblob__shape { position: absolute; inset: 12%; background: linear-gradient(135deg, #cc0200, #7b3fd1 60%, #32125b); border-radius: 42% 58% 63% 37% / 41% 44% 56% 59%; box-shadow: 0 40px 80px -30px rgba(204, 2, 0, 0.6), inset 0 0 60px rgba(255, 255, 255, 0.15); }
  html.motion .iblob__shape { animation: morph 12s ease-in-out infinite; }
  @keyframes morph { 25% { border-radius: 58% 42% 37% 63% / 55% 38% 62% 45%; transform: rotate(20deg); } 50% { border-radius: 38% 62% 52% 48% / 62% 54% 46% 38%; transform: rotate(-10deg) scale(1.04); } 75% { border-radius: 63% 37% 45% 55% / 44% 61% 39% 56%; transform: rotate(8deg); } }
  .iblob__ring { position: absolute; inset: 2%; border-radius: 50%; border: 1px dashed rgba(255, 255, 255, 0.25); }
  html.motion .iblob__ring { animation: spin 26s linear infinite; }
  .iblob__ring i { position: absolute; width: 10px; height: 10px; border-radius: 50%; background: #ff6b5f; box-shadow: 0 0 14px 4px rgba(255, 107, 95, 0.6); }
  .iblob__ring i:nth-child(1) { top: -5px; left: calc(50% - 5px); }
  .iblob__ring i:nth-child(2) { bottom: 14%; left: 4%; background: #e2d2ff; box-shadow: 0 0 12px 4px rgba(160, 120, 240, 0.6); }
  .iblob__ring i:nth-child(3) { bottom: 14%; right: 4%; width: 7px; height: 7px; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .iblob__icon { position: relative; color: #fff; filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.35)); }
  html.motion .iblob__icon { animation: pop 0.9s cubic-bezier(.2,1.5,.4,1) 0.3s both; }
  @keyframes pop { from { transform: scale(0.3) rotate(-20deg); opacity: 0; } }
  .iblob__steps { position: absolute; right: -2%; top: 8%; display: grid; gap: 6px; }
  .iblob__steps span { font-family: var(--font-display); font-size: 15px; color: #fff; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 999px; padding: 3px 10px; backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
  html.motion .iblob__steps span { animation: step-in 0.5s var(--ease) both; animation-delay: calc(0.8s + var(--i) * 0.12s); }
  @keyframes step-in { from { opacity: 0; transform: translateX(20px); } }
</style>
