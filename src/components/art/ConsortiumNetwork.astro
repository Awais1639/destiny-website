---
/** Erasmus Mundus hero art: dotted map of Europe with a network of university cities and travelling pulses
 *  — a joint master's is studied across a consortium of universities in several countries. */
import land from '../../data/land-dots.json';
const LAT0 = 64, LAT1 = 34, LON0 = -11, LON1 = 33, W = 600;
const H = Math.round(((LAT0 - LAT1) / (LON1 - LON0)) * W * 1.35);
const X = (lon: number) => ((lon - LON0) / (LON1 - LON0)) * W;
const Y = (lat: number) => ((LAT0 - lat) / (LAT0 - LAT1)) * H;
const d = (land as number[][]).filter(([la, lo]) => la <= LAT0 && la >= LAT1 && lo >= LON0 && lo <= LON1)
  .map(([la, lo]) => `M${X(lo).toFixed(1)} ${Y(la).toFixed(1)}h0`).join('');
const cities = [
  ['Lisbon', 38.72, -9.14], ['Madrid', 40.42, -3.7], ['Paris', 48.86, 2.35], ['Ghent', 51.05, 3.72], ['Bordeaux', 44.84, -0.58],
  ['Bologna', 44.49, 11.34], ['Barcelona', 41.39, 2.17], ['Uppsala', 59.86, 17.64], ['Berlin', 52.52, 13.4], ['Prague', 50.08, 14.44],
  ['Vienna', 48.21, 16.37], ['Budapest', 47.5, 19.04], ['Krakow', 50.06, 19.94], ['Helsinki', 60.17, 24.94], ['Athens', 37.98, 23.73], ['Glasgow', 55.86, -4.25],
].map(([n, la, lo]) => ({ n: n as string, x: X(lo as number), y: Y(la as number) }));
const links: [number, number][] = [[0, 1], [1, 6], [6, 2], [2, 3], [3, 8], [8, 9], [9, 10], [10, 11], [11, 12], [12, 8], [8, 7], [7, 13], [5, 10], [5, 2], [4, 2], [5, 14], [15, 3], [4, 1]];
---
<div class="cnet" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`}>
    <defs>
      <linearGradient id="cn-l" x1="0" x2="1"><stop offset="0" stop-color="#ff6b5f" stop-opacity=".25" /><stop offset=".5" stop-color="#ff6b5f" stop-opacity=".9" /><stop offset="1" stop-color="#ff6b5f" stop-opacity=".25" /></linearGradient>
    </defs>
    <path d={d} class="cnet__land" />
    {links.map(([a, b], i) => {
      const A = cities[a], B = cities[b];
      const mx = (A.x + B.x) / 2, my = (A.y + B.y) / 2 - Math.hypot(B.x - A.x, B.y - A.y) * 0.18;
      const p = `M${A.x.toFixed(1)} ${A.y.toFixed(1)} Q${mx.toFixed(1)} ${my.toFixed(1)} ${B.x.toFixed(1)} ${B.y.toFixed(1)}`;
      return (
        <g>
          <path d={p} class="cnet__link" style={`--i:${i}`} pathLength="1" />
          <circle r="3" class="cnet__pulse"><animateMotion dur={`${3 + (i % 4)}s`} begin={`${(i * 0.37).toFixed(2)}s`} repeatCount="indefinite" path={p} /></circle>
        </g>
      );
    })}
    {cities.map((c, i) => (
      <g class="cnet__node" style={`--i:${i}`}>
        <circle cx={c.x} cy={c.y} r="11" class="cnet__ring" />
        <circle cx={c.x} cy={c.y} r="4.5" fill="#fff" />
      </g>
    ))}
  </svg>
  <div class="cnet__badge"><b>218</b><span>joint programmes<br />in the official catalogue</span></div>
</div>
<style>
  .cnet { position: relative; width: min(100%, 520px); margin-inline: auto; }
  .cnet svg { width: 100%; height: auto; overflow: visible; }
  .cnet__land { stroke: rgba(214, 196, 245, 0.45); stroke-width: 3.2; stroke-linecap: round; fill: none; }
  .cnet__link { fill: none; stroke: url(#cn-l); stroke-width: 1.4; stroke-dasharray: 1; stroke-dashoffset: 0; }
  html.motion .cnet__link { stroke-dashoffset: 1; animation: cn-draw 1.2s var(--ease) forwards; animation-delay: calc(0.4s + var(--i) * 0.08s); }
  @keyframes cn-draw { to { stroke-dashoffset: 0; } }
  .cnet__pulse { fill: #fff; filter: drop-shadow(0 0 4px #ff6b5f); }
  .cnet__ring { fill: rgba(255, 107, 95, 0.2); transform-box: fill-box; transform-origin: center; }
  html.motion .cnet__ring { animation: cn-ring 2.8s ease-out infinite; animation-delay: calc(var(--i) * 0.17s); }
  @keyframes cn-ring { from { transform: scale(0.5); opacity: 1; } to { transform: scale(2.4); opacity: 0; } }
  html.motion .cnet__node { animation: cn-in 0.5s var(--ease) both; animation-delay: calc(0.2s + var(--i) * 0.06s); }
  @keyframes cn-in { from { opacity: 0; } }
  .cnet__badge { position: absolute; right: 0; bottom: 6%; display: flex; align-items: center; gap: 10px; padding: 10px 16px; border-radius: 14px; background: rgba(18, 5, 31, 0.7); border: 1px solid rgba(255, 255, 255, 0.16); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); color: #efe8f8; font-size: 12.5px; line-height: 1.3; }
  .cnet__badge b { font-family: var(--font-display); font-size: 34px; font-weight: 600; color: var(--coral); }
  @media (prefers-reduced-motion: reduce) { .cnet__pulse { display: none; } }
</style>
