---
/** Contact hero art: a paper plane looping along a dashed flight path into an envelope. */
---
<div class="pplane" aria-hidden="true">
  <svg viewBox="0 0 420 320">
    <path id="pp-path" d="M30 260 C 90 120, 200 300, 230 170 S 330 40, 370 130" fill="none" stroke="rgba(255,255,255,.35)" stroke-width="2" stroke-dasharray="6 8" class="pplane__trail" />
    <g class="pplane__env" transform="translate(300 150)">
      <rect x="0" y="0" width="100" height="70" rx="8" fill="#fff" />
      <path d="M0 6 L50 42 L100 6" fill="none" stroke="#cc0200" stroke-width="4" stroke-linejoin="round" />
      <circle cx="92" cy="8" r="11" fill="#cc0200" class="pplane__badge" /><text x="92" y="12.5" text-anchor="middle" font-size="12" font-weight="800" fill="#fff">1</text>
    </g>
    <g class="pplane__plane">
      <path d="M-18 -10 L20 0 L-18 10 L-10 0 Z" fill="#fff" />
      <path d="M-10 0 L20 0 L-14 5 Z" fill="#dccff3" />
      <animateMotion dur="5s" repeatCount="indefinite" rotate="auto" keyPoints="0;1" keyTimes="0;1" calcMode="spline" keySplines=".45 0 .3 1"><mpath href="#pp-path" /></animateMotion>
    </g>
  </svg>
</div>
<style>
  .pplane { width: min(100%, 440px); margin-inline: auto; }
  @media (max-width: 1023px) { .pplane { width: min(70%, 320px); } }
  .pplane svg { width: 100%; height: auto; overflow: visible; }
  html.motion .pplane__trail { animation: trail 1.2s linear infinite; }
  @keyframes trail { to { stroke-dashoffset: -28; } }
  .pplane__badge { transform-box: fill-box; transform-origin: center; }
  html.motion .pplane__badge { animation: badge 5s ease-in-out infinite; }
  @keyframes badge { 0%, 88% { transform: scale(0); } 94% { transform: scale(1.3); } 100% { transform: scale(1); } }
  @media (prefers-reduced-motion: reduce) { .pplane__plane { display: none; } }
</style>
