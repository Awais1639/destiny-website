---
/** Universities hero art: outline of Italy with glowing university cities and connecting arcs. Decorative. */
import shape from '../../data/italy-shape.json';
interface Props { count?: number; unis?: number; label?: string }
const { count, unis, label } = Astro.props;
const c = shape.cities as Record<string, [number, number]>;
const names = Object.keys(c);
const hubs = ['Milan', 'Bologna', 'Rome', 'Naples', 'Padua', 'Turin'];
const arcs = [['Milan', 'Bologna'], ['Bologna', 'Florence'], ['Florence', 'Rome'], ['Rome', 'Naples'], ['Naples', 'Bari'], ['Turin', 'Milan'], ['Milan', 'Padua'], ['Padua', 'Trento'], ['Rome', "L'Aquila"], ['Naples', 'Palermo'], ['Palermo', 'Catania'], ['Genoa', 'Pisa'], ['Rome', 'Cagliari']];
const arcPath = ([a, b]: string[]) => { const [x1, y1] = c[a], [x2, y2] = c[b]; const mx = (x1 + x2) / 2 + (y2 - y1) * 0.18, my = (y1 + y2) / 2 - (x2 - x1) * 0.18; return `M${x1} ${y1} Q${mx.toFixed(1)} ${my.toFixed(1)} ${x2} ${y2}`; };
---
<div class="itmap" aria-hidden="true">
  <svg viewBox={`0 0 ${shape.W} ${shape.H}`}>
    <defs>
      <linearGradient id="it-fill" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#7b3fd1" stop-opacity=".35" /><stop offset="1" stop-color="#cc0200" stop-opacity=".22" /></linearGradient>
      <pattern id="it-dots" width="9" height="9" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.3" fill="rgba(233,224,245,.5)" /></pattern>
    </defs>
    <path d={shape.d} class="itmap__fill" />
    <path d={shape.d} fill="url(#it-dots)" />
    <path d={shape.d} class="itmap__edge" pathLength="1" />
    {arcs.map((a, i) => <path d={arcPath(a)} class="itmap__arc" style={`--i:${i}`} pathLength="1" />)}
    {names.map((n, i) => (
      <g class="itmap__city" style={`--i:${i}`}>
        {hubs.includes(n) && <circle cx={c[n][0]} cy={c[n][1]} r="10" class="itmap__ring" />}
        <circle cx={c[n][0]} cy={c[n][1]} r={hubs.includes(n) ? 4.5 : 3} fill="#fff" />
      </g>
    ))}
  </svg>
  {count != null && <div class="itmap__badge"><b>{count}</b><span>{label ?? 'programmes taught in English'}{unis ? <><br />at {unis} universities</> : ''}</span></div>}
</div>
<style>
  .itmap { position: relative; width: min(100%, 400px); margin-inline: auto; }
  .itmap svg { width: 100%; height: auto; overflow: visible; }
  .itmap__fill { fill: url(#it-fill); }
  .itmap__edge { fill: none; stroke: rgba(255, 255, 255, .55); stroke-width: 1.2; stroke-dasharray: 1; }
  html.motion .itmap__edge { stroke-dashoffset: 1; animation: it-draw 2.4s var(--ease) .2s forwards; }
  .itmap__arc { fill: none; stroke: var(--coral); stroke-width: 1.3; stroke-opacity: .8; stroke-dasharray: 1; }
  html.motion .itmap__arc { stroke-dashoffset: 1; animation: it-draw 1.1s var(--ease) forwards; animation-delay: calc(1s + var(--i) * .09s); }
  @keyframes it-draw { to { stroke-dashoffset: 0; } }
  .itmap__ring { fill: rgba(255, 107, 95, .25); transform-box: fill-box; transform-origin: center; }
  html.motion .itmap__ring { animation: it-ring 2.6s ease-out infinite; animation-delay: calc(var(--i) * .2s); }
  @keyframes it-ring { from { transform: scale(.5); opacity: 1; } to { transform: scale(2.6); opacity: 0; } }
  html.motion .itmap__city { animation: it-in .5s var(--ease) both; animation-delay: calc(.6s + var(--i) * .05s); }
  @keyframes it-in { from { opacity: 0; } }
  .itmap__badge { position: absolute; left: -4%; bottom: 8%; display: flex; align-items: center; gap: 10px; padding: 10px 16px; border-radius: 14px; background: rgba(18, 5, 31, .72); border: 1px solid rgba(255, 255, 255, .16); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); color: #efe8f8; font-size: 12.5px; line-height: 1.3; }
  .itmap__badge b { font-family: var(--font-display); font-size: 34px; font-weight: 600; color: var(--coral); }
  @media (max-width: 699px) { .itmap { width: min(70%, 260px); } .itmap__badge { left: auto; right: -20%; } }
</style>
