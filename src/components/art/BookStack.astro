---
/** Guides hero art: a shelf of book spines, one per guide — each spine links to its guide. */
import { guides } from '../../data/guides';
import { url } from '../../lib/data';
const colors = ['#32125b', '#cc0200', '#4a2280', '#1c0a33', '#a80200', '#7b3fd1', '#2a0f4c', '#8a0200', '#5a23a0', '#12051f'];
---
<div class="shelf">
  <ul class="shelf__books">
    {guides.map((g, i) => (
      <li style={`--c:${colors[i % colors.length]};--h:${78 + ((i * 37) % 22)}%;--i:${i}`}>
        <a href={url(`/guides/${g.slug}/`)} title={g.title}><span>{g.title.replace(/^How to /, '')}</span></a>
      </li>
    ))}
  </ul>
  <div class="shelf__board" aria-hidden="true"></div>
</div>
<style>
  .shelf { position: relative; max-width: 520px; margin-inline: auto; padding-top: 10px; }
  .shelf__books { list-style: none; display: flex; align-items: flex-end; gap: 6px; height: 280px; padding: 0 12px; }
  .shelf__books li { flex: 1; height: var(--h); transform-origin: bottom center; }
  html.motion .shelf__books li { animation: book-in 0.7s cubic-bezier(.2,1.3,.4,1) both; animation-delay: calc(0.2s + var(--i) * 0.07s); }
  @keyframes book-in { from { transform: translateY(-120px) rotate(-8deg); opacity: 0; } }
  .shelf__books a { display: flex; align-items: center; justify-content: center; height: 100%; border-radius: 4px 4px 2px 2px; background: linear-gradient(90deg, rgba(0,0,0,.25), transparent 18%, transparent 82%, rgba(0,0,0,.2)), var(--c); color: #fff; text-decoration: none; box-shadow: inset 0 0 0 1px rgba(255,255,255,.08), 0 6px 14px -6px rgba(0,0,0,.4); transition: transform 0.3s var(--ease); position: relative; overflow: hidden; }
  .shelf__books a::before, .shelf__books a::after { content: ''; position: absolute; left: 0; right: 0; height: 2px; background: rgba(255, 210, 200, 0.55); }
  .shelf__books a::before { top: 14px; } .shelf__books a::after { bottom: 14px; }
  .shelf__books a span { writing-mode: vertical-rl; transform: rotate(180deg); font-family: var(--font-display); font-size: 13px; font-weight: 500; letter-spacing: 0.02em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-height: 85%; }
  .shelf__books a:hover, .shelf__books a:focus-visible { transform: translateY(-16px); }
  .shelf__board { height: 14px; border-radius: 3px; background: linear-gradient(180deg, #5b4636, #3a2b20); box-shadow: 0 14px 24px -10px rgba(0,0,0,.4); }
  @media (max-width: 560px) { .shelf__books { height: 200px; gap: 4px; } .shelf__books a span { font-size: 11px; } }
</style>
