---
import Icon from './Icon.astro';
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((it) => (
    <details class="faq__item">
      <summary><span>{it.q}</span><Icon name="chevron-down" /></summary>
      <div class="faq__a"><p set:html={it.a} /></div>
    </details>
  ))}
</div>
<style>
  .faq { border-top: 1px solid var(--line); }
  .faq__item { border-bottom: 1px solid var(--line); }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 20px 4px; font-weight: 650; font-size: 17px;
  }
  summary::-webkit-details-marker { display: none; }
  summary :global(svg) { width: 20px; height: 20px; flex: none; color: var(--muted); transition: transform 240ms var(--ease); }
  details[open] summary :global(svg) { transform: rotate(180deg); }
  summary:hover span { color: var(--plum-600); }
  .faq__a { padding: 0 4px 20px; color: var(--muted); max-width: 760px; }
  .faq__a p { margin: 0; }
  details[open] .faq__a { animation: fadeDown 260ms var(--ease); }
  @keyframes fadeDown { from { opacity: 0; transform: translateY(-6px); } }
</style>
