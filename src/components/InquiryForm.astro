---
/**
 * Consultancy inquiry form. There is no server: on submit we validate in the browser, then
 * prepare a message the visitor sends themselves by email or WhatsApp. Nothing is stored.
 */
import Icon from './Icon.astro';
import { site } from '../config/site';
import { services } from '../data/services';
import { url } from '../lib/data';

interface Props {
  id?: string;
  scholarship?: string; // scholarship title, pre-selected
  scholarshipUrl?: string;
  service?: string; // service title, pre-selected
  scholarshipOptions?: string[];
  heading?: string;
}
const { id = 'inquiry', scholarship = '', scholarshipUrl = '', service = '', scholarshipOptions = [], heading } = Astro.props;
const emailOk = /^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i.test(site.contact.email);
const waNumber = site.contact.whatsapp.replace(/\D/g, '');
const waOk = waNumber.length >= 8;
const qualifications = ['Intermediate / A-levels / High school', "Bachelor's degree (or final year)", "Master's degree (or final year)", 'MPhil', 'PhD', 'Other'];
const intended = ["Bachelor's", "Master's", 'PhD', 'Research / Postdoc', 'Not sure yet', 'Not applicable (visa inquiry)'];
import { coaching } from '../data/coaching';
---
<form
  class="inquiry card"
  id={id}
  novalidate
  data-inquiry
  data-email={emailOk ? site.contact.email : ''}
  data-wa={waOk ? waNumber : ''}
  data-company={site.companyName}
  data-scholarship-url={scholarshipUrl}
>
  {heading && <h2 class="display-m" style="font-size:1.6rem">{heading}</h2>}
  <div class="form-grid two mt-4">
    <div class="field">
      <label for={`${id}-name`}>Full name <span class="req" aria-hidden="true">*</span></label>
      <input class="input" id={`${id}-name`} name="name" autocomplete="name" required maxlength="120" aria-describedby={`${id}-name-err`} />
      <p class="error" id={`${id}-name-err`}>Please enter your full name.</p>
    </div>
    <div class="field">
      <label for={`${id}-email`}>Email address <span class="req" aria-hidden="true">*</span></label>
      <input class="input" id={`${id}-email`} name="email" type="email" autocomplete="email" required maxlength="160" aria-describedby={`${id}-email-err`} />
      <p class="error" id={`${id}-email-err`}>Please enter a valid email address, e.g. name@example.com.</p>
    </div>
    <div class="field">
      <label for={`${id}-wa`}>WhatsApp number <span class="hint">(optional)</span></label>
      <input class="input" id={`${id}-wa`} name="whatsapp" type="tel" autocomplete="tel" inputmode="tel" maxlength="24" placeholder="+92 3xx xxxxxxx" aria-describedby={`${id}-wa-err`} />
      <p class="error" id={`${id}-wa-err`}>Use digits, spaces and an optional leading +.</p>
    </div>
    <div class="field">
      <label for={`${id}-nat`}>Nationality <span class="req" aria-hidden="true">*</span></label>
      <input class="input" id={`${id}-nat`} name="nationality" autocomplete="country-name" required maxlength="80" aria-describedby={`${id}-nat-err`} />
      <p class="error" id={`${id}-nat-err`}>Please enter your nationality.</p>
    </div>
    <div class="field">
      <label for={`${id}-res`}>Current country of residence <span class="req" aria-hidden="true">*</span></label>
      <input class="input" id={`${id}-res`} name="residence" required maxlength="80" aria-describedby={`${id}-res-err`} />
      <p class="error" id={`${id}-res-err`}>Please enter where you currently live.</p>
    </div>
    <div class="field">
      <label for={`${id}-qual`}>Highest completed qualification <span class="req" aria-hidden="true">*</span></label>
      <select class="select" id={`${id}-qual`} name="qualification" required aria-describedby={`${id}-qual-err`}>
        <option value="">Select…</option>
        {qualifications.map((q) => <option>{q}</option>)}
      </select>
      <p class="error" id={`${id}-qual-err`}>Please choose your highest qualification.</p>
    </div>
    <div class="field">
      <label for={`${id}-deg`}>Intended degree level <span class="req" aria-hidden="true">*</span></label>
      <select class="select" id={`${id}-deg`} name="intended" required aria-describedby={`${id}-deg-err`}>
        <option value="">Select…</option>
        {intended.map((q) => <option>{q}</option>)}
      </select>
      <p class="error" id={`${id}-deg-err`}>Please choose the level you are aiming for.</p>
    </div>
    {scholarship ? (
      <div class="field">
        <label for={`${id}-sch`}>Selected scholarship</label>
        <input class="input" id={`${id}-sch`} name="scholarship" value={scholarship} readonly />
      </div>
    ) : (
      <div class="field">
        <label for={`${id}-svc`}>What do you need help with? <span class="req" aria-hidden="true">*</span></label>
        <select class="select" id={`${id}-svc`} name="service" required aria-describedby={`${id}-svc-err`}>
          <option value="">Select a service…</option>
          {services.map((s) => <option selected={s.title === service}>{s.title}</option>)}
          {coaching.map((s) => <option selected={s.title === service}>{s.title}</option>)}
          <option>Something else</option>
        </select>
        <p class="error" id={`${id}-svc-err`}>Please choose a service.</p>
      </div>
    )}
    {!scholarship && scholarshipOptions.length > 0 && (
      <div class="field span-2">
        <label for={`${id}-sch2`}>Scholarship you are interested in <span class="hint">(optional)</span></label>
        <select class="select" id={`${id}-sch2`} name="scholarship">
          <option value="">None / not sure</option>
          {scholarshipOptions.map((t) => <option>{t}</option>)}
        </select>
      </div>
    )}
    <div class="field span-2">
      <label for={`${id}-bg`}>Relevant academic background <span class="req" aria-hidden="true">*</span></label>
      <textarea class="textarea" id={`${id}-bg`} name="background" required maxlength="1200" rows="3" placeholder="e.g. BS Mathematics, 2021, CGPA 3.6/4.0; IELTS 7.0; 2 years teaching experience" aria-describedby={`${id}-bg-err`}></textarea>
      <p class="error" id={`${id}-bg-err`}>Please add a short summary of your studies (degree, year, grades).</p>
    </div>
    <div class="field span-2">
      <label for={`${id}-msg`}>Your message or question</label>
      <textarea class="textarea" id={`${id}-msg`} name="message" maxlength="2000" rows="4"></textarea>
      <p class="hint">Please don’t include passwords, passport numbers or bank details.</p>
    </div>
    <div class="field span-2">
      <label class="check">
        <input type="checkbox" name="consent" required aria-describedby={`${id}-consent-err`} />
        <span>I have read the <a href={url('/privacy-policy/')} target="_blank">privacy notice</a> and understand that consultancy assistance is a separate, independent service that does not guarantee admission, scholarship selection or visa approval. <span class="req" aria-hidden="true">*</span></span>
      </label>
      <p class="error" id={`${id}-consent-err`}>Please confirm you have read the privacy notice.</p>
    </div>
  </div>

  <div class="notice mt-5">
    <Icon name="info" />
    <p><strong>How sending works:</strong> this website has no database and does not store your details. When you continue, we prepare your message so <strong>you</strong> can send it from your own email app{waOk ? ' or WhatsApp' : ''}. It is only delivered once you press Send there.</p>
  </div>

  <div class="mt-5 flex wrap gap-3">
    <button class="btn btn-primary btn-lg" type="submit">Prepare my inquiry <Icon name="arrow-right" /></button>
  </div>

  <div class="inquiry-result" hidden data-result tabindex="-1">
    <div class="notice notice-ok">
      <Icon name="check-circle" />
      <div>
        <p><strong>Your message is ready — but it has not been sent yet.</strong></p>
        <p class="mt-2">Choose how to send it below. Your email app or WhatsApp will open with the message filled in; press <em>Send</em> there to deliver it.</p>
      </div>
    </div>
    <div class="mt-4 flex wrap gap-3">
      {emailOk && <a class="btn btn-dark" data-mailto href="#"><Icon name="mail" /> Open email draft</a>}
      {waOk && <a class="btn btn-dark" data-wa-link href="#" target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" /> Open in WhatsApp</a>}
      <button class="btn btn-outline" type="button" data-copy><Icon name="copy" /> <span data-copy-text>Copy message</span></button>
    </div>
    {emailOk && (
      <p class="small muted mt-3">If no email app opens, copy the message and send it to <strong style="color:var(--ink)">{site.contact.email}</strong> from any email service.</p>
    )}
    {!emailOk && !waOk && (
      <div class="notice notice-warn mt-3"><Icon name="alert" /><p>Business contact details have not been configured yet. Please copy your message and keep it until contact details are published on this site.</p></div>
    )}
    <details class="mt-4"><summary class="small" style="cursor:pointer;font-weight:600">Preview message</summary><pre class="preview" data-preview></pre></details>
  </div>
</form>

<style>
  .inquiry { padding: 22px; }
  @media (min-width: 700px) { .inquiry { padding: 32px; } }
  .inquiry-result { margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--line); outline: none; }
  .preview { white-space: pre-wrap; font-size: 13px; background: var(--paper); padding: 14px; border-radius: 6px; border: 1px solid var(--line); margin-top: 10px; font-family: ui-monospace, Consolas, monospace; max-height: 280px; overflow: auto; }
</style>

<script>
  const clean = (v: string) => v.replace(/[\u0000-\u0008\u000b-\u001f\u007f]/g, '').trim();
  const EMAIL = /^[^\s@<>()]+@[^\s@<>()]+\.[a-z]{2,}$/i;
  const PHONE = /^\+?[\d\s()-]{7,20}$/;

  document.querySelectorAll<HTMLFormElement>('[data-inquiry]').forEach((form) => {
    const result = form.querySelector<HTMLElement>('[data-result]')!;
    const setInvalid = (el: Element, bad: boolean) => {
      const field = el.closest('.field');
      if (!field) return;
      if (bad) { field.setAttribute('data-invalid', ''); el.setAttribute('aria-invalid', 'true'); }
      else { field.removeAttribute('data-invalid'); el.removeAttribute('aria-invalid'); }
    };
    const check = (el: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) => {
      let bad = false;
      if (el instanceof HTMLInputElement && el.type === 'checkbox') bad = el.required && !el.checked;
      else {
        const v = clean(el.value);
        if (el.required && !v) bad = true;
        else if (el.name === 'email' && v && !EMAIL.test(v)) bad = true;
        else if (el.name === 'whatsapp' && v && !PHONE.test(v)) bad = true;
        else if (el.name === 'background' && v && v.length < 10) bad = true;
      }
      setInvalid(el, bad);
      return !bad;
    };
    form.querySelectorAll<HTMLInputElement>('input, select, textarea').forEach((el) => {
      el.addEventListener('blur', () => { if (el.value || el.closest('[data-invalid]')) check(el); });
      el.addEventListener('change', () => { if (el.closest('[data-invalid]')) check(el); });
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const els = [...form.querySelectorAll<HTMLInputElement>('input:not([readonly]), select, textarea')];
      const invalid = els.filter((el) => !check(el));
      if (invalid.length) {
        invalid[0].focus();
        (window as any).dgoAnnounce?.(`Please fix ${invalid.length} field${invalid.length > 1 ? 's' : ''} highlighted in red.`);
        return;
      }
      const fd = new FormData(form);
      const g = (k: string) => clean(String(fd.get(k) ?? ''));
      const topic = g('scholarship') || g('service') || 'General inquiry';
      const lines = [
        `Hello ${form.dataset.company},`,
        '',
        `I would like consultancy assistance regarding: ${topic}`,
        form.dataset.scholarshipUrl ? `Scholarship page: ${form.dataset.scholarshipUrl}` : '',
        '',
        `Full name: ${g('name')}`,
        `Email: ${g('email')}`,
        g('whatsapp') ? `WhatsApp: ${g('whatsapp')}` : '',
        `Nationality: ${g('nationality')}`,
        `Country of residence: ${g('residence')}`,
        `Highest qualification: ${g('qualification')}`,
        `Intended degree level: ${g('intended')}`,
        g('service') && g('scholarship') ? `Scholarship of interest: ${g('scholarship')}` : '',
        '',
        'Academic background:',
        g('background'),
        g('message') ? '\nMessage:\n' + g('message') : '',
        '',
        'I confirm I have read the privacy notice and understand assistance does not guarantee admission, scholarship selection or visa approval.',
      ].filter((l, i, arr) => !(l === '' && arr[i - 1] === ''));
      const body = lines.join('\n').replace(/\n{3,}/g, '\n\n');
      const subject = `Assistance request: ${topic} — ${g('name')}`.slice(0, 150);

      const mail = form.querySelector<HTMLAnchorElement>('[data-mailto]');
      if (mail && form.dataset.email) mail.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body.replace(/\n/g, '\r\n'))}`;
      const wa = form.querySelector<HTMLAnchorElement>('[data-wa-link]');
      if (wa && form.dataset.wa) wa.href = `https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(body)}`;
      form.querySelector('[data-preview]')!.textContent = `Subject: ${subject}\n\n${body}`;
      const copy = form.querySelector<HTMLButtonElement>('[data-copy]')!;
      copy.onclick = async () => {
        const t = copy.querySelector('[data-copy-text]')!;
        try { await navigator.clipboard.writeText(`Subject: ${subject}\n\n${body}`); t.textContent = 'Copied'; }
        catch { t.textContent = 'Copy failed — use the preview'; (form.querySelector('details') as HTMLDetailsElement).open = true; }
        setTimeout(() => (t.textContent = 'Copy message'), 2500);
      };
      result.hidden = false;
      result.focus();
      (window as any).dgoAnnounce?.('Your message is ready. It has not been sent yet — choose email or copy to send it yourself.');
    });
  });
</script>
