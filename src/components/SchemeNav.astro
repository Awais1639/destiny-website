---
/** Sub-headings of the Scholarships section: all scholarships, each named scheme, and the comparison table. */
import { url } from '../lib/data';
import { schemes } from '../data/schemes';
interface Props { current?: string; dark?: boolean }
const { current = '', dark = false } = Astro.props;
const items = [{ label: 'All scholarships', href: '/scholarships/' }, ...schemes, { label: 'Compare schemes', href: '/scholarships/compare/' }];
---
<nav class:list={['snav', { 'snav--dark': dark }]} aria-label="Scholarship schemes">
  <ul>
    {items.map((s) => (
      <li><a href={url(s.href)} aria-current={current === s.href ? 'page' : undefined}>{s.label}{'note' in s && s.note && <span>{s.note}</span>}</a></li>
    ))}
  </ul>
</nav>
<style>
  .snav { position: relative; margin-top: 26px; }
  .snav ul { list-style: none; margin: 0; padding: 2px 2px 10px; display: flex; gap: 8px; overflow-x: auto; scrollbar-width: thin; scroll-snap-type: x proximity; }
  .snav li { flex: none; scroll-snap-align: start; }
  .snav a { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 6px 14px; border-radius: 999px; font-size: 14px; font-weight: 650; text-decoration: none; white-space: nowrap; border: 1px solid var(--line); background: #fff; color: var(--ink-2); transition: background 160ms var(--ease), border-color 160ms var(--ease), color 160ms var(--ease); }
  .snav a:hover { border-color: var(--plum-600); color: var(--plum-700); }
  .snav a[aria-current='page'] { background: var(--plum-700); border-color: var(--plum-700); color: #fff; }
  .snav a span { font-size: 11.5px; font-weight: 700; padding: 1px 7px; border-radius: 999px; background: var(--red-50); color: var(--red-700); }
  .snav--dark a { background: rgba(255,255,255,.07); border-color: rgba(255,255,255,.2); color: #efe8f8; }
  .snav--dark a:hover { border-color: var(--coral); color: #fff; }
  .snav--dark a[aria-current='page'] { background: #fff; color: var(--plum-900); border-color: #fff; }
  .snav--dark a span { background: rgba(255,107,95,.22); color: #ffd9d5; }
</style>
<style>
  @media (min-width: 900px) { .snav ul { mask-image: linear-gradient(90deg, #000 88%, transparent); -webkit-mask-image: linear-gradient(90deg, #000 88%, transparent); padding-right: 60px; } }
</style>
