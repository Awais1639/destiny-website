---
import { getStatus, statusText, type Scholarship } from '../lib/scholarships';
interface Props { s: Scholarship }
const { s } = Astro.props;
const st = getStatus(s);
const label = statusText(st, s.dates.deadline);
const payload = JSON.stringify({ dates: s.dates, statusOverride: s.statusOverride });
---
<span class={`badge badge-dot badge-${st}`} data-live-status={payload}>{label}</span>
