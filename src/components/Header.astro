---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { url } from '../lib/data';
import { schemes } from '../data/schemes';
import { it as italy } from '../lib/italy';
import { services } from '../data/services';
import { coaching } from '../data/coaching';
import { tools } from '../data/tools';

interface Props { overDark?: boolean }
const { overDark = false } = Astro.props;

interface Item { href: string; label: string; note?: string }
interface Group { title: string; href: string; icon: string; items: Item[] }
interface Nav { href: string; label: string; id?: string; all?: Item; menu?: Item[]; foot?: Item; cols?: number; groups?: Group[] }
const topSchemes = ['CSC China', 'MEXT Japan', 'GKS Korea', 'Türkiye Bursları', 'Chevening', 'Stipendium Hungaricum'];
const opportunities: Group[] = [
  {
    title: 'Scholarships', href: '/scholarships/', icon: 'award',
    items: [
      { href: '/scholarships/', label: 'All scholarships' },
      ...schemes.filter((sc) => ['Erasmus Mundus', 'Italy regional grants'].includes(sc.label)).map((sc) => ({ href: sc.href, label: sc.label, note: sc.note })),
      ...topSchemes.map((l) => schemes.find((sc) => sc.label === l)).filter(Boolean).map((sc) => ({ href: sc!.href, label: sc!.label })),
      { href: '/scholarships/compare/', label: `All ${schemes.length} schemes compared` },
    ],
  },
  {
    title: 'Study destinations', href: '/countries/', icon: 'globe',
    items: [
      ...(italy.count > 0 ? [{ href: '/universities/', label: 'Universities' }] : []),
      { href: '/countries/', label: 'Countries' },
      { href: '/erasmus-mundus/', label: 'Erasmus Mundus master’s' },
      { href: '/find/?type=course', label: 'English-taught degrees' },
    ],
  },
  {
    title: 'PhD and research', href: '/phd/', icon: 'graduation',
    items: [
      { href: '/phd/', label: 'PhD positions' },
      { href: '/postdoc/', label: 'Postdoc positions' },
      { href: '/fellowships/', label: 'Fellowships' },
      { href: '/internships/', label: 'Internships and theses' },
    ],
  },
  {
    title: 'Events', href: '/conferences/', icon: 'calendar',
    items: [
      { href: '/conferences/', label: 'Conferences and summits' },
      { href: '/guides/how-to-spot-fake-conferences/', label: 'How to spot fake conferences' },
    ],
  },
];
const nav: Nav[] = [
  { href: '/find/', label: 'Find courses' },
  { href: '/scholarships/', label: 'Opportunities', id: 'menu-opps', groups: opportunities },
  {
    href: '/tools/', label: 'Tools', id: 'menu-tools', cols: 2,
    all: { href: '/tools/', label: 'All free tools', note: 'Eligibility, grades, visas and planning' },
    menu: tools.filter((t) => !t.external && t.href !== '/contact/').map((t) => ({ href: t.href, label: t.label })),
  },
  {
    href: '/services/', label: 'Services', id: 'menu-services', cols: 2,
    all: { href: '/services/', label: 'All consultancy services', note: 'Admissions, scholarships and visas' },
    menu: [...services.map((sv) => ({ href: `/services/${sv.slug}/`, label: sv.title })), ...coaching.map((c) => ({ href: `/coaching/${c.slug}/`, label: c.title, note: 'Coaching' }))],
    foot: { href: '/coaching/', label: 'Test coaching', note: 'IELTS, PTE, SAT, Life in the UK' },
  },
  { href: '/guides/', label: 'Guides' },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
];
const oppPrefixes = ['/scholarships/', '/universities/', '/countries/', '/erasmus-mundus/', '/phd/', '/postdoc/', '/fellowships/', '/internships/', '/conferences/'];
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const isCurrent = (href: string, groups?: Group[]) => groups ? oppPrefixes.some((pre) => path.startsWith(pre)) : path.startsWith(href);
---
<header class:list={['site-header', { 'over-dark': overDark }]} data-header>
  <div class="container">
    <Logo variant={overDark ? 'auto' : 'color'} />
    <nav class="nav-main" aria-label="Main">
      <ul>
        {nav.map((n) => n.groups ? (
          <li class="has-menu has-mega" data-navmenu>
            <a href={url(n.href)} aria-current={isCurrent(n.href, n.groups) ? 'page' : undefined}>{n.label}</a>
            <button class="nav-caret" type="button" aria-expanded="false" aria-controls={n.id} aria-label={`Show ${n.label.toLowerCase()} menu`} data-navmenu-btn><Icon name="chevron-down" /></button>
            <div class="navmenu navmenu--mega" id={n.id}>
              <div class="mega__grid">
                {n.groups.map((g) => (
                  <div class="mega__col">
                    <a class="mega__title" href={url(g.href)}><Icon name={g.icon} size={16} /> {g.title}</a>
                    {g.items.map((it) => <a href={url(it.href)}>{it.label}</a>)}
                  </div>
                ))}
              </div>
              <a class="mega__foot" href={url('/find/')}><Icon name="search" size={15} /> Search courses, scholarships, PhD positions and more in one place <Icon name="arrow-right" size={14} /></a>
            </div>
          </li>
        ) : n.menu ? (
          <li class="has-menu" data-navmenu>
            <a href={url(n.href)} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>
            <button class="nav-caret" type="button" aria-expanded="false" aria-controls={n.id} aria-label={`Show ${n.label.toLowerCase()} menu`} data-navmenu-btn><Icon name="chevron-down" /></button>
            <div class:list={['navmenu', `navmenu--${n.cols}`]} id={n.id}>
              <div class="navmenu__grid">
                {n.all && <a class="navmenu__all" href={url(n.all.href)}><b>{n.all.label}</b><span>{n.all.note}</span></a>}
                {n.menu.map((sc) => <a href={url(sc.href)}>{sc.label}{sc.note && <small>{sc.note}</small>}</a>)}
                {n.foot && <a class="navmenu__all" href={url(n.foot.href)}><b>{n.foot.label}</b><span>{n.foot.note}</span></a>}
              </div>
            </div>
          </li>
        ) : (
          <li><a href={url(n.href)} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="header-actions">
      <a class="icon-btn" href={url('/saved/')} aria-label="Saved scholarships" title="Saved scholarships">
        <Icon name="bookmark" />
        <span class="saved-count" data-saved-count data-n="0" aria-hidden="true"></span>
      </a>
      <a class="btn btn-primary btn-sm header-cta" href={url('/contact/')}>Free inquiry</a>
      <button class="icon-btn menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
        <Icon name="menu" />
      </button>
    </div>
  </div>
</header>

<div class="drawer" id="mobile-menu" data-drawer role="dialog" aria-modal="true" aria-label="Menu">
  <div class="drawer__backdrop" data-drawer-close></div>
  <div class="drawer__panel">
    <div class="drawer__head">
      <Logo size="sm" />
      <button class="icon-btn" type="button" aria-label="Close menu" data-drawer-close><Icon name="x" /></button>
    </div>
    <ul class="drawer__nav">
      <li><a href={url('/')} aria-current={path === '/' ? 'page' : undefined}>Home <Icon name="chevron-right" /></a></li>
      {nav.map((n) => n.groups ? (
        <li>
          <details class="drawer__sub">
            <summary>{n.label} <Icon name="chevron-down" /></summary>
            <ul>
              {n.groups.map((g) => (
                <li>
                  <details class="drawer__sub drawer__sub--inner">
                    <summary>{g.title} <Icon name="chevron-down" /></summary>
                    <ul>{g.items.map((it) => <li><a href={url(it.href)}>{it.label}</a></li>)}</ul>
                  </details>
                </li>
              ))}
            </ul>
          </details>
        </li>
      ) : n.menu ? (
        <li>
          <details class="drawer__sub">
            <summary>{n.label} <Icon name="chevron-down" /></summary>
            <ul>
              {n.all && <li><a href={url(n.all.href)}>{n.all.label}</a></li>}
              {n.menu.map((sc) => <li><a href={url(sc.href)}>{sc.label}</a></li>)}
              {n.foot && <li><a href={url(n.foot.href)}>{n.foot.label}</a></li>}
            </ul>
          </details>
        </li>
      ) : (
        <li><a href={url(n.href)} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label} <Icon name="chevron-right" /></a></li>
      ))}
      <li><a href={url('/saved/')}>Saved scholarships <Icon name="chevron-right" /></a></li>
      <li><a href={url('/contact/')}>Contact <Icon name="chevron-right" /></a></li>
    </ul>
    <div class="drawer__foot">
      <a class="btn btn-primary btn-block" href={url('/find/')}><Icon name="search" /> Find courses & scholarships</a>
      <a class="btn btn-outline btn-block" href={url('/contact/')}>Get consultancy assistance</a>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-navmenu]').forEach((li) => {
    const btn = li.querySelector<HTMLButtonElement>('[data-navmenu-btn]')!;
    const set = (open: boolean) => { btn.setAttribute('aria-expanded', String(open)); li.toggleAttribute('data-open', open); };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    li.addEventListener('keydown', (e) => { if (e.key === 'Escape') { set(false); btn.focus(); } });
    li.addEventListener('focusout', (e) => { if (!li.contains(e.relatedTarget as Node)) set(false); });
    document.addEventListener('click', (e) => { if (!li.contains(e.target as Node)) set(false); });
  });
</script>
